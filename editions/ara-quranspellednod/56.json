{
    "chapter": [
        {
            "chapter": 56,
            "verse": 1,
            "text": "اذا وقعت الواقعة"
        },
        {
            "chapter": 56,
            "verse": 2,
            "text": "ليس لوقعتها كاذبة"
        },
        {
            "chapter": 56,
            "verse": 3,
            "text": "خافضة رافعة"
        },
        {
            "chapter": 56,
            "verse": 4,
            "text": "اذا رجت الارض رجا"
        },
        {
            "chapter": 56,
            "verse": 5,
            "text": "وبست الجبال بسا"
        },
        {
            "chapter": 56,
            "verse": 6,
            "text": "فكانت هباء منبثا"
        },
        {
            "chapter": 56,
            "verse": 7,
            "text": "وكنتم ازواجا ثلاثة"
        },
        {
            "chapter": 56,
            "verse": 8,
            "text": "فاصحاب الميمنة ما اصحاب الميمنة"
        },
        {
            "chapter": 56,
            "verse": 9,
            "text": "واصحاب المشامة ما اصحاب المشامة"
        },
        {
            "chapter": 56,
            "verse": 10,
            "text": "والسابقون السابقون"
        },
        {
            "chapter": 56,
            "verse": 11,
            "text": "اوليك المقربون"
        },
        {
            "chapter": 56,
            "verse": 12,
            "text": "في جنات النعيم"
        },
        {
            "chapter": 56,
            "verse": 13,
            "text": "ثلة من الاولين"
        },
        {
            "chapter": 56,
            "verse": 14,
            "text": "وقليل من الاخرين"
        },
        {
            "chapter": 56,
            "verse": 15,
            "text": "على سرر موضونة"
        },
        {
            "chapter": 56,
            "verse": 16,
            "text": "متكيين عليها متقابلين"
        },
        {
            "chapter": 56,
            "verse": 17,
            "text": "يطوف عليهم ولدان مخلدون"
        },
        {
            "chapter": 56,
            "verse": 18,
            "text": "باكواب واباريق وكاس من معين"
        },
        {
            "chapter": 56,
            "verse": 19,
            "text": "لا يصدعون عنها ولا ينزفون"
        },
        {
            "chapter": 56,
            "verse": 20,
            "text": "وفاكهة مما يتخيرون"
        },
        {
            "chapter": 56,
            "verse": 21,
            "text": "ولحم طير مما يشتهون"
        },
        {
            "chapter": 56,
            "verse": 22,
            "text": "وحور عين"
        },
        {
            "chapter": 56,
            "verse": 23,
            "text": "كامثال اللولو المكنون"
        },
        {
            "chapter": 56,
            "verse": 24,
            "text": "جزاء بما كانوا يعملون"
        },
        {
            "chapter": 56,
            "verse": 25,
            "text": "لا يسمعون فيها لغوا ولا تاثيما"
        },
        {
            "chapter": 56,
            "verse": 26,
            "text": "الا قيلا سلاما سلاما"
        },
        {
            "chapter": 56,
            "verse": 27,
            "text": "واصحاب اليمين ما اصحاب اليمين"
        },
        {
            "chapter": 56,
            "verse": 28,
            "text": "في سدر مخضود"
        },
        {
            "chapter": 56,
            "verse": 29,
            "text": "وطلح منضود"
        },
        {
            "chapter": 56,
            "verse": 30,
            "text": "وظل ممدود"
        },
        {
            "chapter": 56,
            "verse": 31,
            "text": "وماء مسكوب"
        },
        {
            "chapter": 56,
            "verse": 32,
            "text": "وفاكهة كثيرة"
        },
        {
            "chapter": 56,
            "verse": 33,
            "text": "لا مقطوعة ولا ممنوعة"
        },
        {
            "chapter": 56,
            "verse": 34,
            "text": "وفرش مرفوعة"
        },
        {
            "chapter": 56,
            "verse": 35,
            "text": "انا انشاناهن انشاء"
        },
        {
            "chapter": 56,
            "verse": 36,
            "text": "فجعلناهن ابكارا"
        },
        {
            "chapter": 56,
            "verse": 37,
            "text": "عربا اترابا"
        },
        {
            "chapter": 56,
            "verse": 38,
            "text": "لاصحاب اليمين"
        },
        {
            "chapter": 56,
            "verse": 39,
            "text": "ثلة من الاولين"
        },
        {
            "chapter": 56,
            "verse": 40,
            "text": "وثلة من الاخرين"
        },
        {
            "chapter": 56,
            "verse": 41,
            "text": "واصحاب الشمال ما اصحاب الشمال"
        },
        {
            "chapter": 56,
            "verse": 42,
            "text": "في سموم وحميم"
        },
        {
            "chapter": 56,
            "verse": 43,
            "text": "وظل من يحموم"
        },
        {
            "chapter": 56,
            "verse": 44,
            "text": "لا بارد ولا كريم"
        },
        {
            "chapter": 56,
            "verse": 45,
            "text": "انهم كانوا قبل ذلك مترفين"
        },
        {
            "chapter": 56,
            "verse": 46,
            "text": "وكانوا يصرون على الحنث العظيم"
        },
        {
            "chapter": 56,
            "verse": 47,
            "text": "وكانوا يقولون ايذا متنا وكنا ترابا وعظاما اانا لمبعوثون"
        },
        {
            "chapter": 56,
            "verse": 48,
            "text": "اواباونا الاولون"
        },
        {
            "chapter": 56,
            "verse": 49,
            "text": "قل ان الاولين والاخرين"
        },
        {
            "chapter": 56,
            "verse": 50,
            "text": "لمجموعون الى ميقات يوم معلوم"
        },
        {
            "chapter": 56,
            "verse": 51,
            "text": "ثم انكم ايها الضالون المكذبون"
        },
        {
            "chapter": 56,
            "verse": 52,
            "text": "لاكلون من شجر من زقوم"
        },
        {
            "chapter": 56,
            "verse": 53,
            "text": "فماليون منها البطون"
        },
        {
            "chapter": 56,
            "verse": 54,
            "text": "فشاربون عليه من الحميم"
        },
        {
            "chapter": 56,
            "verse": 55,
            "text": "فشاربون شرب الهيم"
        },
        {
            "chapter": 56,
            "verse": 56,
            "text": "هذا نزلهم يوم الدين"
        },
        {
            "chapter": 56,
            "verse": 57,
            "text": "نحن خلقناكم فلولا تصدقون"
        },
        {
            "chapter": 56,
            "verse": 58,
            "text": "افرايتم ما تمنون"
        },
        {
            "chapter": 56,
            "verse": 59,
            "text": "اانتم تخلقونه ام نحن الخالقون"
        },
        {
            "chapter": 56,
            "verse": 60,
            "text": "نحن قدرنا بينكم الموت وما نحن بمسبوقين"
        },
        {
            "chapter": 56,
            "verse": 61,
            "text": "على ان نبدل امثالكم وننشيكم في ما لا تعلمون"
        },
        {
            "chapter": 56,
            "verse": 62,
            "text": "ولقد علمتم النشاة الاولى فلولا تذكرون"
        },
        {
            "chapter": 56,
            "verse": 63,
            "text": "افرايتم ما تحرثون"
        },
        {
            "chapter": 56,
            "verse": 64,
            "text": "اانتم تزرعونه ام نحن الزارعون"
        },
        {
            "chapter": 56,
            "verse": 65,
            "text": "لو نشاء لجعلناه حطاما فظلتم تفكهون"
        },
        {
            "chapter": 56,
            "verse": 66,
            "text": "انا لمغرمون"
        },
        {
            "chapter": 56,
            "verse": 67,
            "text": "بل نحن محرومون"
        },
        {
            "chapter": 56,
            "verse": 68,
            "text": "افرايتم الماء الذي تشربون"
        },
        {
            "chapter": 56,
            "verse": 69,
            "text": "اانتم انزلتموه من المزن ام نحن المنزلون"
        },
        {
            "chapter": 56,
            "verse": 70,
            "text": "لو نشاء جعلناه اجاجا فلولا تشكرون"
        },
        {
            "chapter": 56,
            "verse": 71,
            "text": "افرايتم النار التي تورون"
        },
        {
            "chapter": 56,
            "verse": 72,
            "text": "اانتم انشاتم شجرتها ام نحن المنشيون"
        },
        {
            "chapter": 56,
            "verse": 73,
            "text": "نحن جعلناها تذكرة ومتاعا للمقوين"
        },
        {
            "chapter": 56,
            "verse": 74,
            "text": "فسبح باسم ربك العظيم"
        },
        {
            "chapter": 56,
            "verse": 75,
            "text": "فلا اقسم بمواقع النجوم"
        },
        {
            "chapter": 56,
            "verse": 76,
            "text": "وانه لقسم لو تعلمون عظيم"
        },
        {
            "chapter": 56,
            "verse": 77,
            "text": "انه لقران كريم"
        },
        {
            "chapter": 56,
            "verse": 78,
            "text": "في كتاب مكنون"
        },
        {
            "chapter": 56,
            "verse": 79,
            "text": "لا يمسه الا المطهرون"
        },
        {
            "chapter": 56,
            "verse": 80,
            "text": "تنزيل من رب العالمين"
        },
        {
            "chapter": 56,
            "verse": 81,
            "text": "افبهذا الحديث انتم مدهنون"
        },
        {
            "chapter": 56,
            "verse": 82,
            "text": "وتجعلون رزقكم انكم تكذبون"
        },
        {
            "chapter": 56,
            "verse": 83,
            "text": "فلولا اذا بلغت الحلقوم"
        },
        {
            "chapter": 56,
            "verse": 84,
            "text": "وانتم حينيذ تنظرون"
        },
        {
            "chapter": 56,
            "verse": 85,
            "text": "ونحن اقرب اليه منكم ولكن لا تبصرون"
        },
        {
            "chapter": 56,
            "verse": 86,
            "text": "فلولا ان كنتم غير مدينين"
        },
        {
            "chapter": 56,
            "verse": 87,
            "text": "ترجعونها ان كنتم صادقين"
        },
        {
            "chapter": 56,
            "verse": 88,
            "text": "فاما ان كان من المقربين"
        },
        {
            "chapter": 56,
            "verse": 89,
            "text": "فروح وريحان وجنت نعيم"
        },
        {
            "chapter": 56,
            "verse": 90,
            "text": "واما ان كان من اصحاب اليمين"
        },
        {
            "chapter": 56,
            "verse": 91,
            "text": "فسلام لك من اصحاب اليمين"
        },
        {
            "chapter": 56,
            "verse": 92,
            "text": "واما ان كان من المكذبين الضالين"
        },
        {
            "chapter": 56,
            "verse": 93,
            "text": "فنزل من حميم"
        },
        {
            "chapter": 56,
            "verse": 94,
            "text": "وتصلية جحيم"
        },
        {
            "chapter": 56,
            "verse": 95,
            "text": "ان هذا لهو حق اليقين"
        },
        {
            "chapter": 56,
            "verse": 96,
            "text": "فسبح باسم ربك العظيم"
        }
    ]
}