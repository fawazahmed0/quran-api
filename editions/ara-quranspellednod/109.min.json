{"chapter":[{"chapter":109,"verse":1,"text":"قل يا ايها الكافرون"},{"chapter":109,"verse":2,"text":"لا اعبد ما تعبدون"},{"chapter":109,"verse":3,"text":"ولا انتم عابدون ما اعبد"},{"chapter":109,"verse":4,"text":"ولا انا عابد ما عبدتم"},{"chapter":109,"verse":5,"text":"ولا انتم عابدون ما اعبد"},{"chapter":109,"verse":6,"text":"لكم دينكم ولي دين"}]}