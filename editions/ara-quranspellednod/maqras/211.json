{
    "maqras": [
        {
            "chapter": 53,
            "verse": 26,
            "text": "وكم من ملك في السماوات لا تغني شفاعتهم شييا الا من بعد ان ياذن الله لمن يشاء ويرضى"
        },
        {
            "chapter": 53,
            "verse": 27,
            "text": "ان الذين لا يومنون بالاخرة ليسمون الملايكة تسمية الانثى"
        },
        {
            "chapter": 53,
            "verse": 28,
            "text": "وما لهم به من علم ان يتبعون الا الظن وان الظن لا يغني من الحق شييا"
        },
        {
            "chapter": 53,
            "verse": 29,
            "text": "فاعرض عن من تولى عن ذكرنا ولم يرد الا الحياة الدنيا"
        },
        {
            "chapter": 53,
            "verse": 30,
            "text": "ذلك مبلغهم من العلم ان ربك هو اعلم بمن ضل عن سبيله وهو اعلم بمن اهتدى"
        },
        {
            "chapter": 53,
            "verse": 31,
            "text": "ولله ما في السماوات وما في الارض ليجزي الذين اساءوا بما عملوا ويجزي الذين احسنوا بالحسنى"
        },
        {
            "chapter": 53,
            "verse": 32,
            "text": "الذين يجتنبون كباير الاثم والفواحش الا اللمم ان ربك واسع المغفرة هو اعلم بكم اذ انشاكم من الارض واذ انتم اجنة في بطون امهاتكم فلا تزكوا انفسكم هو اعلم بمن اتقى"
        },
        {
            "chapter": 53,
            "verse": 33,
            "text": "افرايت الذي تولى"
        },
        {
            "chapter": 53,
            "verse": 34,
            "text": "واعطى قليلا واكدى"
        },
        {
            "chapter": 53,
            "verse": 35,
            "text": "اعنده علم الغيب فهو يرى"
        },
        {
            "chapter": 53,
            "verse": 36,
            "text": "ام لم ينبا بما في صحف موسى"
        },
        {
            "chapter": 53,
            "verse": 37,
            "text": "وابراهيم الذي وفى"
        },
        {
            "chapter": 53,
            "verse": 38,
            "text": "الا تزر وازرة وزر اخرى"
        },
        {
            "chapter": 53,
            "verse": 39,
            "text": "وان ليس للانسان الا ما سعى"
        },
        {
            "chapter": 53,
            "verse": 40,
            "text": "وان سعيه سوف يرى"
        },
        {
            "chapter": 53,
            "verse": 41,
            "text": "ثم يجزاه الجزاء الاوفى"
        },
        {
            "chapter": 53,
            "verse": 42,
            "text": "وان الى ربك المنتهى"
        },
        {
            "chapter": 53,
            "verse": 43,
            "text": "وانه هو اضحك وابكى"
        },
        {
            "chapter": 53,
            "verse": 44,
            "text": "وانه هو امات واحيا"
        },
        {
            "chapter": 53,
            "verse": 45,
            "text": "وانه خلق الزوجين الذكر والانثى"
        },
        {
            "chapter": 53,
            "verse": 46,
            "text": "من نطفة اذا تمنى"
        },
        {
            "chapter": 53,
            "verse": 47,
            "text": "وان عليه النشاة الاخرى"
        },
        {
            "chapter": 53,
            "verse": 48,
            "text": "وانه هو اغنى واقنى"
        },
        {
            "chapter": 53,
            "verse": 49,
            "text": "وانه هو رب الشعرى"
        },
        {
            "chapter": 53,
            "verse": 50,
            "text": "وانه اهلك عادا الاولى"
        },
        {
            "chapter": 53,
            "verse": 51,
            "text": "وثمود فما ابقى"
        },
        {
            "chapter": 53,
            "verse": 52,
            "text": "وقوم نوح من قبل انهم كانوا هم اظلم واطغى"
        },
        {
            "chapter": 53,
            "verse": 53,
            "text": "والموتفكة اهوى"
        },
        {
            "chapter": 53,
            "verse": 54,
            "text": "فغشاها ما غشى"
        },
        {
            "chapter": 53,
            "verse": 55,
            "text": "فباي الاء ربك تتمارى"
        },
        {
            "chapter": 53,
            "verse": 56,
            "text": "هذا نذير من النذر الاولى"
        },
        {
            "chapter": 53,
            "verse": 57,
            "text": "ازفت الازفة"
        },
        {
            "chapter": 53,
            "verse": 58,
            "text": "ليس لها من دون الله كاشفة"
        },
        {
            "chapter": 53,
            "verse": 59,
            "text": "افمن هذا الحديث تعجبون"
        },
        {
            "chapter": 53,
            "verse": 60,
            "text": "وتضحكون ولا تبكون"
        },
        {
            "chapter": 53,
            "verse": 61,
            "text": "وانتم سامدون"
        },
        {
            "chapter": 53,
            "verse": 62,
            "text": "فاسجدوا لله واعبدوا"
        },
        {
            "chapter": 54,
            "verse": 1,
            "text": "اقتربت الساعة وانشق القمر"
        },
        {
            "chapter": 54,
            "verse": 2,
            "text": "وان يروا اية يعرضوا ويقولوا سحر مستمر"
        },
        {
            "chapter": 54,
            "verse": 3,
            "text": "وكذبوا واتبعوا اهواءهم وكل امر مستقر"
        },
        {
            "chapter": 54,
            "verse": 4,
            "text": "ولقد جاءهم من الانباء ما فيه مزدجر"
        },
        {
            "chapter": 54,
            "verse": 5,
            "text": "حكمة بالغة فما تغن النذر"
        },
        {
            "chapter": 54,
            "verse": 6,
            "text": "فتول عنهم يوم يدع الداع الى شيء نكر"
        },
        {
            "chapter": 54,
            "verse": 7,
            "text": "خشعا ابصارهم يخرجون من الاجداث كانهم جراد منتشر"
        },
        {
            "chapter": 54,
            "verse": 8,
            "text": "مهطعين الى الداع يقول الكافرون هذا يوم عسر"
        }
    ]
}