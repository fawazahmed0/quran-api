{
    "maqras": [
        {
            "chapter": 26,
            "verse": 1,
            "text": "طسم"
        },
        {
            "chapter": 26,
            "verse": 2,
            "text": "تلك ايات الكتاب المبين"
        },
        {
            "chapter": 26,
            "verse": 3,
            "text": "لعلك باخع نفسك الا يكونوا مومنين"
        },
        {
            "chapter": 26,
            "verse": 4,
            "text": "ان نشا ننزل عليهم من السماء اية فظلت اعناقهم لها خاضعين"
        },
        {
            "chapter": 26,
            "verse": 5,
            "text": "وما ياتيهم من ذكر من الرحمن محدث الا كانوا عنه معرضين"
        },
        {
            "chapter": 26,
            "verse": 6,
            "text": "فقد كذبوا فسياتيهم انباء ما كانوا به يستهزيون"
        },
        {
            "chapter": 26,
            "verse": 7,
            "text": "اولم يروا الى الارض كم انبتنا فيها من كل زوج كريم"
        },
        {
            "chapter": 26,
            "verse": 8,
            "text": "ان في ذلك لاية وما كان اكثرهم مومنين"
        },
        {
            "chapter": 26,
            "verse": 9,
            "text": "وان ربك لهو العزيز الرحيم"
        },
        {
            "chapter": 26,
            "verse": 10,
            "text": "واذ نادى ربك موسى ان ايت القوم الظالمين"
        },
        {
            "chapter": 26,
            "verse": 11,
            "text": "قوم فرعون الا يتقون"
        },
        {
            "chapter": 26,
            "verse": 12,
            "text": "قال رب اني اخاف ان يكذبون"
        },
        {
            "chapter": 26,
            "verse": 13,
            "text": "ويضيق صدري ولا ينطلق لساني فارسل الى هارون"
        },
        {
            "chapter": 26,
            "verse": 14,
            "text": "ولهم علي ذنب فاخاف ان يقتلون"
        },
        {
            "chapter": 26,
            "verse": 15,
            "text": "قال كلا فاذهبا باياتنا انا معكم مستمعون"
        },
        {
            "chapter": 26,
            "verse": 16,
            "text": "فاتيا فرعون فقولا انا رسول رب العالمين"
        },
        {
            "chapter": 26,
            "verse": 17,
            "text": "ان ارسل معنا بني اسراييل"
        },
        {
            "chapter": 26,
            "verse": 18,
            "text": "قال الم نربك فينا وليدا ولبثت فينا من عمرك سنين"
        },
        {
            "chapter": 26,
            "verse": 19,
            "text": "وفعلت فعلتك التي فعلت وانت من الكافرين"
        },
        {
            "chapter": 26,
            "verse": 20,
            "text": "قال فعلتها اذا وانا من الضالين"
        },
        {
            "chapter": 26,
            "verse": 21,
            "text": "ففررت منكم لما خفتكم فوهب لي ربي حكما وجعلني من المرسلين"
        },
        {
            "chapter": 26,
            "verse": 22,
            "text": "وتلك نعمة تمنها علي ان عبدت بني اسراييل"
        },
        {
            "chapter": 26,
            "verse": 23,
            "text": "قال فرعون وما رب العالمين"
        },
        {
            "chapter": 26,
            "verse": 24,
            "text": "قال رب السماوات والارض وما بينهما ان كنتم موقنين"
        },
        {
            "chapter": 26,
            "verse": 25,
            "text": "قال لمن حوله الا تستمعون"
        },
        {
            "chapter": 26,
            "verse": 26,
            "text": "قال ربكم ورب ابايكم الاولين"
        },
        {
            "chapter": 26,
            "verse": 27,
            "text": "قال ان رسولكم الذي ارسل اليكم لمجنون"
        },
        {
            "chapter": 26,
            "verse": 28,
            "text": "قال رب المشرق والمغرب وما بينهما ان كنتم تعقلون"
        },
        {
            "chapter": 26,
            "verse": 29,
            "text": "قال لين اتخذت الها غيري لاجعلنك من المسجونين"
        },
        {
            "chapter": 26,
            "verse": 30,
            "text": "قال اولو جيتك بشيء مبين"
        },
        {
            "chapter": 26,
            "verse": 31,
            "text": "قال فات به ان كنت من الصادقين"
        },
        {
            "chapter": 26,
            "verse": 32,
            "text": "فالقى عصاه فاذا هي ثعبان مبين"
        },
        {
            "chapter": 26,
            "verse": 33,
            "text": "ونزع يده فاذا هي بيضاء للناظرين"
        },
        {
            "chapter": 26,
            "verse": 34,
            "text": "قال للملا حوله ان هذا لساحر عليم"
        },
        {
            "chapter": 26,
            "verse": 35,
            "text": "يريد ان يخرجكم من ارضكم بسحره فماذا تامرون"
        },
        {
            "chapter": 26,
            "verse": 36,
            "text": "قالوا ارجه واخاه وابعث في المداين حاشرين"
        },
        {
            "chapter": 26,
            "verse": 37,
            "text": "ياتوك بكل سحار عليم"
        },
        {
            "chapter": 26,
            "verse": 38,
            "text": "فجمع السحرة لميقات يوم معلوم"
        },
        {
            "chapter": 26,
            "verse": 39,
            "text": "وقيل للناس هل انتم مجتمعون"
        },
        {
            "chapter": 26,
            "verse": 40,
            "text": "لعلنا نتبع السحرة ان كانوا هم الغالبين"
        },
        {
            "chapter": 26,
            "verse": 41,
            "text": "فلما جاء السحرة قالوا لفرعون اين لنا لاجرا ان كنا نحن الغالبين"
        },
        {
            "chapter": 26,
            "verse": 42,
            "text": "قال نعم وانكم اذا لمن المقربين"
        },
        {
            "chapter": 26,
            "verse": 43,
            "text": "قال لهم موسى القوا ما انتم ملقون"
        },
        {
            "chapter": 26,
            "verse": 44,
            "text": "فالقوا حبالهم وعصيهم وقالوا بعزة فرعون انا لنحن الغالبون"
        },
        {
            "chapter": 26,
            "verse": 45,
            "text": "فالقى موسى عصاه فاذا هي تلقف ما يافكون"
        },
        {
            "chapter": 26,
            "verse": 46,
            "text": "فالقي السحرة ساجدين"
        },
        {
            "chapter": 26,
            "verse": 47,
            "text": "قالوا امنا برب العالمين"
        },
        {
            "chapter": 26,
            "verse": 48,
            "text": "رب موسى وهارون"
        },
        {
            "chapter": 26,
            "verse": 49,
            "text": "قال امنتم له قبل ان اذن لكم انه لكبيركم الذي علمكم السحر فلسوف تعلمون لاقطعن ايديكم وارجلكم من خلاف ولاصلبنكم اجمعين"
        },
        {
            "chapter": 26,
            "verse": 50,
            "text": "قالوا لا ضير انا الى ربنا منقلبون"
        },
        {
            "chapter": 26,
            "verse": 51,
            "text": "انا نطمع ان يغفر لنا ربنا خطايانا ان كنا اول المومنين"
        }
    ]
}