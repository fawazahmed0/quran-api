{
    "maqras": [
        {
            "chapter": 78,
            "verse": 1,
            "text": "عم يتساءلون"
        },
        {
            "chapter": 78,
            "verse": 2,
            "text": "عن النبا العظيم"
        },
        {
            "chapter": 78,
            "verse": 3,
            "text": "الذي هم فيه مختلفون"
        },
        {
            "chapter": 78,
            "verse": 4,
            "text": "كلا سيعلمون"
        },
        {
            "chapter": 78,
            "verse": 5,
            "text": "ثم كلا سيعلمون"
        },
        {
            "chapter": 78,
            "verse": 6,
            "text": "الم نجعل الارض مهادا"
        },
        {
            "chapter": 78,
            "verse": 7,
            "text": "والجبال اوتادا"
        },
        {
            "chapter": 78,
            "verse": 8,
            "text": "وخلقناكم ازواجا"
        },
        {
            "chapter": 78,
            "verse": 9,
            "text": "وجعلنا نومكم سباتا"
        },
        {
            "chapter": 78,
            "verse": 10,
            "text": "وجعلنا الليل لباسا"
        },
        {
            "chapter": 78,
            "verse": 11,
            "text": "وجعلنا النهار معاشا"
        },
        {
            "chapter": 78,
            "verse": 12,
            "text": "وبنينا فوقكم سبعا شدادا"
        },
        {
            "chapter": 78,
            "verse": 13,
            "text": "وجعلنا سراجا وهاجا"
        },
        {
            "chapter": 78,
            "verse": 14,
            "text": "وانزلنا من المعصرات ماء ثجاجا"
        },
        {
            "chapter": 78,
            "verse": 15,
            "text": "لنخرج به حبا ونباتا"
        },
        {
            "chapter": 78,
            "verse": 16,
            "text": "وجنات الفافا"
        },
        {
            "chapter": 78,
            "verse": 17,
            "text": "ان يوم الفصل كان ميقاتا"
        },
        {
            "chapter": 78,
            "verse": 18,
            "text": "يوم ينفخ في الصور فتاتون افواجا"
        },
        {
            "chapter": 78,
            "verse": 19,
            "text": "وفتحت السماء فكانت ابوابا"
        },
        {
            "chapter": 78,
            "verse": 20,
            "text": "وسيرت الجبال فكانت سرابا"
        },
        {
            "chapter": 78,
            "verse": 21,
            "text": "ان جهنم كانت مرصادا"
        },
        {
            "chapter": 78,
            "verse": 22,
            "text": "للطاغين مابا"
        },
        {
            "chapter": 78,
            "verse": 23,
            "text": "لابثين فيها احقابا"
        },
        {
            "chapter": 78,
            "verse": 24,
            "text": "لا يذوقون فيها بردا ولا شرابا"
        },
        {
            "chapter": 78,
            "verse": 25,
            "text": "الا حميما وغساقا"
        },
        {
            "chapter": 78,
            "verse": 26,
            "text": "جزاء وفاقا"
        },
        {
            "chapter": 78,
            "verse": 27,
            "text": "انهم كانوا لا يرجون حسابا"
        },
        {
            "chapter": 78,
            "verse": 28,
            "text": "وكذبوا باياتنا كذابا"
        },
        {
            "chapter": 78,
            "verse": 29,
            "text": "وكل شيء احصيناه كتابا"
        },
        {
            "chapter": 78,
            "verse": 30,
            "text": "فذوقوا فلن نزيدكم الا عذابا"
        },
        {
            "chapter": 78,
            "verse": 31,
            "text": "ان للمتقين مفازا"
        },
        {
            "chapter": 78,
            "verse": 32,
            "text": "حدايق واعنابا"
        },
        {
            "chapter": 78,
            "verse": 33,
            "text": "وكواعب اترابا"
        },
        {
            "chapter": 78,
            "verse": 34,
            "text": "وكاسا دهاقا"
        },
        {
            "chapter": 78,
            "verse": 35,
            "text": "لا يسمعون فيها لغوا ولا كذابا"
        },
        {
            "chapter": 78,
            "verse": 36,
            "text": "جزاء من ربك عطاء حسابا"
        },
        {
            "chapter": 78,
            "verse": 37,
            "text": "رب السماوات والارض وما بينهما الرحمن لا يملكون منه خطابا"
        },
        {
            "chapter": 78,
            "verse": 38,
            "text": "يوم يقوم الروح والملايكة صفا لا يتكلمون الا من اذن له الرحمن وقال صوابا"
        },
        {
            "chapter": 78,
            "verse": 39,
            "text": "ذلك اليوم الحق فمن شاء اتخذ الى ربه مابا"
        },
        {
            "chapter": 78,
            "verse": 40,
            "text": "انا انذرناكم عذابا قريبا يوم ينظر المرء ما قدمت يداه ويقول الكافر يا ليتني كنت ترابا"
        },
        {
            "chapter": 79,
            "verse": 1,
            "text": "والنازعات غرقا"
        },
        {
            "chapter": 79,
            "verse": 2,
            "text": "والناشطات نشطا"
        },
        {
            "chapter": 79,
            "verse": 3,
            "text": "والسابحات سبحا"
        },
        {
            "chapter": 79,
            "verse": 4,
            "text": "فالسابقات سبقا"
        },
        {
            "chapter": 79,
            "verse": 5,
            "text": "فالمدبرات امرا"
        },
        {
            "chapter": 79,
            "verse": 6,
            "text": "يوم ترجف الراجفة"
        },
        {
            "chapter": 79,
            "verse": 7,
            "text": "تتبعها الرادفة"
        },
        {
            "chapter": 79,
            "verse": 8,
            "text": "قلوب يوميذ واجفة"
        },
        {
            "chapter": 79,
            "verse": 9,
            "text": "ابصارها خاشعة"
        },
        {
            "chapter": 79,
            "verse": 10,
            "text": "يقولون اانا لمردودون في الحافرة"
        },
        {
            "chapter": 79,
            "verse": 11,
            "text": "ااذا كنا عظاما نخرة"
        },
        {
            "chapter": 79,
            "verse": 12,
            "text": "قالوا تلك اذا كرة خاسرة"
        },
        {
            "chapter": 79,
            "verse": 13,
            "text": "فانما هي زجرة واحدة"
        },
        {
            "chapter": 79,
            "verse": 14,
            "text": "فاذا هم بالساهرة"
        },
        {
            "chapter": 79,
            "verse": 15,
            "text": "هل اتاك حديث موسى"
        },
        {
            "chapter": 79,
            "verse": 16,
            "text": "اذ ناداه ربه بالواد المقدس طوى"
        },
        {
            "chapter": 79,
            "verse": 17,
            "text": "اذهب الى فرعون انه طغى"
        },
        {
            "chapter": 79,
            "verse": 18,
            "text": "فقل هل لك الى ان تزكى"
        },
        {
            "chapter": 79,
            "verse": 19,
            "text": "واهديك الى ربك فتخشى"
        },
        {
            "chapter": 79,
            "verse": 20,
            "text": "فاراه الاية الكبرى"
        },
        {
            "chapter": 79,
            "verse": 21,
            "text": "فكذب وعصى"
        },
        {
            "chapter": 79,
            "verse": 22,
            "text": "ثم ادبر يسعى"
        },
        {
            "chapter": 79,
            "verse": 23,
            "text": "فحشر فنادى"
        },
        {
            "chapter": 79,
            "verse": 24,
            "text": "فقال انا ربكم الاعلى"
        },
        {
            "chapter": 79,
            "verse": 25,
            "text": "فاخذه الله نكال الاخرة والاولى"
        },
        {
            "chapter": 79,
            "verse": 26,
            "text": "ان في ذلك لعبرة لمن يخشى"
        },
        {
            "chapter": 79,
            "verse": 27,
            "text": "اانتم اشد خلقا ام السماء بناها"
        },
        {
            "chapter": 79,
            "verse": 28,
            "text": "رفع سمكها فسواها"
        },
        {
            "chapter": 79,
            "verse": 29,
            "text": "واغطش ليلها واخرج ضحاها"
        },
        {
            "chapter": 79,
            "verse": 30,
            "text": "والارض بعد ذلك دحاها"
        },
        {
            "chapter": 79,
            "verse": 31,
            "text": "اخرج منها ماءها ومرعاها"
        },
        {
            "chapter": 79,
            "verse": 32,
            "text": "والجبال ارساها"
        },
        {
            "chapter": 79,
            "verse": 33,
            "text": "متاعا لكم ولانعامكم"
        },
        {
            "chapter": 79,
            "verse": 34,
            "text": "فاذا جاءت الطامة الكبرى"
        },
        {
            "chapter": 79,
            "verse": 35,
            "text": "يوم يتذكر الانسان ما سعى"
        },
        {
            "chapter": 79,
            "verse": 36,
            "text": "وبرزت الجحيم لمن يرى"
        },
        {
            "chapter": 79,
            "verse": 37,
            "text": "فاما من طغى"
        },
        {
            "chapter": 79,
            "verse": 38,
            "text": "واثر الحياة الدنيا"
        },
        {
            "chapter": 79,
            "verse": 39,
            "text": "فان الجحيم هي الماوى"
        },
        {
            "chapter": 79,
            "verse": 40,
            "text": "واما من خاف مقام ربه ونهى النفس عن الهوى"
        },
        {
            "chapter": 79,
            "verse": 41,
            "text": "فان الجنة هي الماوى"
        },
        {
            "chapter": 79,
            "verse": 42,
            "text": "يسالونك عن الساعة ايان مرساها"
        },
        {
            "chapter": 79,
            "verse": 43,
            "text": "فيم انت من ذكراها"
        },
        {
            "chapter": 79,
            "verse": 44,
            "text": "الى ربك منتهاها"
        },
        {
            "chapter": 79,
            "verse": 45,
            "text": "انما انت منذر من يخشاها"
        },
        {
            "chapter": 79,
            "verse": 46,
            "text": "كانهم يوم يرونها لم يلبثوا الا عشية او ضحاها"
        }
    ]
}