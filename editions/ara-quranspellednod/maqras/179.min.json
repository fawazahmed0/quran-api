{"maqras":[{"chapter":37,"verse":22,"text":"احشروا الذين ظلموا وازواجهم وما كانوا يعبدون"},{"chapter":37,"verse":23,"text":"من دون الله فاهدوهم الى صراط الجحيم"},{"chapter":37,"verse":24,"text":"وقفوهم انهم مسيولون"},{"chapter":37,"verse":25,"text":"ما لكم لا تناصرون"},{"chapter":37,"verse":26,"text":"بل هم اليوم مستسلمون"},{"chapter":37,"verse":27,"text":"واقبل بعضهم على بعض يتساءلون"},{"chapter":37,"verse":28,"text":"قالوا انكم كنتم تاتوننا عن اليمين"},{"chapter":37,"verse":29,"text":"قالوا بل لم تكونوا مومنين"},{"chapter":37,"verse":30,"text":"وما كان لنا عليكم من سلطان بل كنتم قوما طاغين"},{"chapter":37,"verse":31,"text":"فحق علينا قول ربنا انا لذايقون"},{"chapter":37,"verse":32,"text":"فاغويناكم انا كنا غاوين"},{"chapter":37,"verse":33,"text":"فانهم يوميذ في العذاب مشتركون"},{"chapter":37,"verse":34,"text":"انا كذلك نفعل بالمجرمين"},{"chapter":37,"verse":35,"text":"انهم كانوا اذا قيل لهم لا اله الا الله يستكبرون"},{"chapter":37,"verse":36,"text":"ويقولون اينا لتاركو الهتنا لشاعر مجنون"},{"chapter":37,"verse":37,"text":"بل جاء بالحق وصدق المرسلين"},{"chapter":37,"verse":38,"text":"انكم لذايقو العذاب الاليم"},{"chapter":37,"verse":39,"text":"وما تجزون الا ما كنتم تعملون"},{"chapter":37,"verse":40,"text":"الا عباد الله المخلصين"},{"chapter":37,"verse":41,"text":"اوليك لهم رزق معلوم"},{"chapter":37,"verse":42,"text":"فواكه وهم مكرمون"},{"chapter":37,"verse":43,"text":"في جنات النعيم"},{"chapter":37,"verse":44,"text":"على سرر متقابلين"},{"chapter":37,"verse":45,"text":"يطاف عليهم بكاس من معين"},{"chapter":37,"verse":46,"text":"بيضاء لذة للشاربين"},{"chapter":37,"verse":47,"text":"لا فيها غول ولا هم عنها ينزفون"},{"chapter":37,"verse":48,"text":"وعندهم قاصرات الطرف عين"},{"chapter":37,"verse":49,"text":"كانهن بيض مكنون"},{"chapter":37,"verse":50,"text":"فاقبل بعضهم على بعض يتساءلون"},{"chapter":37,"verse":51,"text":"قال قايل منهم اني كان لي قرين"},{"chapter":37,"verse":52,"text":"يقول اانك لمن المصدقين"},{"chapter":37,"verse":53,"text":"ااذا متنا وكنا ترابا وعظاما اا