{
    "maqras": [
        {
            "chapter": 94,
            "verse": 1,
            "text": "الم نشرح لك صدرك"
        },
        {
            "chapter": 94,
            "verse": 2,
            "text": "ووضعنا عنك وزرك"
        },
        {
            "chapter": 94,
            "verse": 3,
            "text": "الذي انقض ظهرك"
        },
        {
            "chapter": 94,
            "verse": 4,
            "text": "ورفعنا لك ذكرك"
        },
        {
            "chapter": 94,
            "verse": 5,
            "text": "فان مع العسر يسرا"
        },
        {
            "chapter": 94,
            "verse": 6,
            "text": "ان مع العسر يسرا"
        },
        {
            "chapter": 94,
            "verse": 7,
            "text": "فاذا فرغت فانصب"
        },
        {
            "chapter": 94,
            "verse": 8,
            "text": "والى ربك فارغب"
        },
        {
            "chapter": 95,
            "verse": 1,
            "text": "والتين والزيتون"
        },
        {
            "chapter": 95,
            "verse": 2,
            "text": "وطور سينين"
        },
        {
            "chapter": 95,
            "verse": 3,
            "text": "وهذا البلد الامين"
        },
        {
            "chapter": 95,
            "verse": 4,
            "text": "لقد خلقنا الانسان في احسن تقويم"
        },
        {
            "chapter": 95,
            "verse": 5,
            "text": "ثم رددناه اسفل سافلين"
        },
        {
            "chapter": 95,
            "verse": 6,
            "text": "الا الذين امنوا وعملوا الصالحات فلهم اجر غير ممنون"
        },
        {
            "chapter": 95,
            "verse": 7,
            "text": "فما يكذبك بعد بالدين"
        },
        {
            "chapter": 95,
            "verse": 8,
            "text": "اليس الله باحكم الحاكمين"
        },
        {
            "chapter": 96,
            "verse": 1,
            "text": "اقرا باسم ربك الذي خلق"
        },
        {
            "chapter": 96,
            "verse": 2,
            "text": "خلق الانسان من علق"
        },
        {
            "chapter": 96,
            "verse": 3,
            "text": "اقرا وربك الاكرم"
        },
        {
            "chapter": 96,
            "verse": 4,
            "text": "الذي علم بالقلم"
        },
        {
            "chapter": 96,
            "verse": 5,
            "text": "علم الانسان ما لم يعلم"
        },
        {
            "chapter": 96,
            "verse": 6,
            "text": "كلا ان الانسان ليطغى"
        },
        {
            "chapter": 96,
            "verse": 7,
            "text": "ان راه استغنى"
        },
        {
            "chapter": 96,
            "verse": 8,
            "text": "ان الى ربك الرجعى"
        },
        {
            "chapter": 96,
            "verse": 9,
            "text": "ارايت الذي ينهى"
        },
        {
            "chapter": 96,
            "verse": 10,
            "text": "عبدا اذا صلى"
        },
        {
            "chapter": 96,
            "verse": 11,
            "text": "ارايت ان كان على الهدى"
        },
        {
            "chapter": 96,
            "verse": 12,
            "text": "او امر بالتقوى"
        },
        {
            "chapter": 96,
            "verse": 13,
            "text": "ارايت ان كذب وتولى"
        },
        {
            "chapter": 96,
            "verse": 14,
            "text": "الم يعلم بان الله يرى"
        },
        {
            "chapter": 96,
            "verse": 15,
            "text": "كلا لين لم ينته لنسفعا بالناصية"
        },
        {
            "chapter": 96,
            "verse": 16,
            "text": "ناصية كاذبة خاطية"
        },
        {
            "chapter": 96,
            "verse": 17,
            "text": "فليدع ناديه"
        },
        {
            "chapter": 96,
            "verse": 18,
            "text": "سندع الزبانية"
        },
        {
            "chapter": 96,
            "verse": 19,
            "text": "كلا لا تطعه واسجد واقترب"
        },
        {
            "chapter": 97,
            "verse": 1,
            "text": "انا انزلناه في ليلة القدر"
        },
        {
            "chapter": 97,
            "verse": 2,
            "text": "وما ادراك ما ليلة القدر"
        },
        {
            "chapter": 97,
            "verse": 3,
            "text": "ليلة القدر خير من الف شهر"
        },
        {
            "chapter": 97,
            "verse": 4,
            "text": "تنزل الملايكة والروح فيها باذن ربهم من كل امر"
        },
        {
            "chapter": 97,
            "verse": 5,
            "text": "سلام هي حتى مطلع الفجر"
        },
        {
            "chapter": 98,
            "verse": 1,
            "text": "لم يكن الذين كفروا من اهل الكتاب والمشركين منفكين حتى تاتيهم البينة"
        },
        {
            "chapter": 98,
            "verse": 2,
            "text": "رسول من الله يتلو صحفا مطهرة"
        },
        {
            "chapter": 98,
            "verse": 3,
            "text": "فيها كتب قيمة"
        },
        {
            "chapter": 98,
            "verse": 4,
            "text": "وما تفرق الذين اوتوا الكتاب الا من بعد ما جاءتهم البينة"
        },
        {
            "chapter": 98,
            "verse": 5,
            "text": "وما امروا الا ليعبدوا الله مخلصين له الدين حنفاء ويقيموا الصلاة ويوتوا الزكاة وذلك دين القيمة"
        },
        {
            "chapter": 98,
            "verse": 6,
            "text": "ان الذين كفروا من اهل الكتاب والمشركين في نار جهنم خالدين فيها اوليك هم شر البرية"
        },
        {
            "chapter": 98,
            "verse": 7,
            "text": "ان الذين امنوا وعملوا الصالحات اوليك هم خير البرية"
        },
        {
            "chapter": 98,
            "verse": 8,
            "text": "جزاوهم عند ربهم جنات عدن تجري من تحتها الانهار خالدين فيها ابدا رضي الله عنهم ورضوا عنه ذلك لمن خشي ربه"
        },
        {
            "chapter": 99,
            "verse": 1,
            "text": "اذا زلزلت الارض زلزالها"
        },
        {
            "chapter": 99,
            "verse": 2,
            "text": "واخرجت الارض اثقالها"
        },
        {
            "chapter": 99,
            "verse": 3,
            "text": "وقال الانسان ما لها"
        },
        {
            "chapter": 99,
            "verse": 4,
            "text": "يوميذ تحدث اخبارها"
        },
        {
            "chapter": 99,
            "verse": 5,
            "text": "بان ربك اوحى لها"
        },
        {
            "chapter": 99,
            "verse": 6,
            "text": "يوميذ يصدر الناس اشتاتا ليروا اعمالهم"
        },
        {
            "chapter": 99,
            "verse": 7,
            "text": "فمن يعمل مثقال ذرة خيرا يره"
        },
        {
            "chapter": 99,
            "verse": 8,
            "text": "ومن يعمل مثقال ذرة شرا يره"
        },
        {
            "chapter": 100,
            "verse": 1,
            "text": "والعاديات ضبحا"
        },
        {
            "chapter": 100,
            "verse": 2,
            "text": "فالموريات قدحا"
        },
        {
            "chapter": 100,
            "verse": 3,
            "text": "فالمغيرات صبحا"
        },
        {
            "chapter": 100,
            "verse": 4,
            "text": "فاثرن به نقعا"
        },
        {
            "chapter": 100,
            "verse": 5,
            "text": "فوسطن به جمعا"
        },
        {
            "chapter": 100,
            "verse": 6,
            "text": "ان الانسان لربه لكنود"
        },
        {
            "chapter": 100,
            "verse": 7,
            "text": "وانه على ذلك لشهيد"
        },
        {
            "chapter": 100,
            "verse": 8,
            "text": "وانه لحب الخير لشديد"
        }
    ]
}