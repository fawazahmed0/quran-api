{
    "maqras": [
        {
            "chapter": 44,
            "verse": 17,
            "text": "ولقد فتنا قبلهم قوم فرعون وجاءهم رسول كريم"
        },
        {
            "chapter": 44,
            "verse": 18,
            "text": "ان ادوا الي عباد الله اني لكم رسول امين"
        },
        {
            "chapter": 44,
            "verse": 19,
            "text": "وان لا تعلوا على الله اني اتيكم بسلطان مبين"
        },
        {
            "chapter": 44,
            "verse": 20,
            "text": "واني عذت بربي وربكم ان ترجمون"
        },
        {
            "chapter": 44,
            "verse": 21,
            "text": "وان لم تومنوا لي فاعتزلون"
        },
        {
            "chapter": 44,
            "verse": 22,
            "text": "فدعا ربه ان هولاء قوم مجرمون"
        },
        {
            "chapter": 44,
            "verse": 23,
            "text": "فاسر بعبادي ليلا انكم متبعون"
        },
        {
            "chapter": 44,
            "verse": 24,
            "text": "واترك البحر رهوا انهم جند مغرقون"
        },
        {
            "chapter": 44,
            "verse": 25,
            "text": "كم تركوا من جنات وعيون"
        },
        {
            "chapter": 44,
            "verse": 26,
            "text": "وزروع ومقام كريم"
        },
        {
            "chapter": 44,
            "verse": 27,
            "text": "ونعمة كانوا فيها فاكهين"
        },
        {
            "chapter": 44,
            "verse": 28,
            "text": "كذلك واورثناها قوما اخرين"
        },
        {
            "chapter": 44,
            "verse": 29,
            "text": "فما بكت عليهم السماء والارض وما كانوا منظرين"
        },
        {
            "chapter": 44,
            "verse": 30,
            "text": "ولقد نجينا بني اسراييل من العذاب المهين"
        },
        {
            "chapter": 44,
            "verse": 31,
            "text": "من فرعون انه كان عاليا من المسرفين"
        },
        {
            "chapter": 44,
            "verse": 32,
            "text": "ولقد اخترناهم على علم على العالمين"
        },
        {
            "chapter": 44,
            "verse": 33,
            "text": "واتيناهم من الايات ما فيه بلاء مبين"
        },
        {
            "chapter": 44,
            "verse": 34,
            "text": "ان هولاء ليقولون"
        },
        {
            "chapter": 44,
            "verse": 35,
            "text": "ان هي الا موتتنا الاولى وما نحن بمنشرين"
        },
        {
            "chapter": 44,
            "verse": 36,
            "text": "فاتوا باباينا ان كنتم صادقين"
        },
        {
            "chapter": 44,
            "verse": 37,
            "text": "اهم خير ام قوم تبع والذين من قبلهم اهلكناهم انهم كانوا مجرمين"
        },
        {
            "chapter": 44,
            "verse": 38,
            "text": "وما خلقنا السماوات والارض وما بينهما لاعبين"
        },
        {
            "chapter": 44,
            "verse": 39,
            "text": "ما خلقناهما الا بالحق ولكن اكثرهم لا يعلمون"
        },
        {
            "chapter": 44,
            "verse": 40,
            "text": "ان يوم الفصل ميقاتهم اجمعين"
        },
        {
            "chapter": 44,
            "verse": 41,
            "text": "يوم لا يغني مولى عن مولى شييا ولا هم ينصرون"
        },
        {
            "chapter": 44,
            "verse": 42,
            "text": "الا من رحم الله انه هو العزيز الرحيم"
        },
        {
            "chapter": 44,
            "verse": 43,
            "text": "ان شجرت الزقوم"
        },
        {
            "chapter": 44,
            "verse": 44,
            "text": "طعام الاثيم"
        },
        {
            "chapter": 44,
            "verse": 45,
            "text": "كالمهل يغلي في البطون"
        },
        {
            "chapter": 44,
            "verse": 46,
            "text": "كغلي الحميم"
        },
        {
            "chapter": 44,
            "verse": 47,
            "text": "خذوه فاعتلوه الى سواء الجحيم"
        },
        {
            "chapter": 44,
            "verse": 48,
            "text": "ثم صبوا فوق راسه من عذاب الحميم"
        },
        {
            "chapter": 44,
            "verse": 49,
            "text": "ذق انك انت العزيز الكريم"
        },
        {
            "chapter": 44,
            "verse": 50,
            "text": "ان هذا ما كنتم به تمترون"
        },
        {
            "chapter": 44,
            "verse": 51,
            "text": "ان المتقين في مقام امين"
        },
        {
            "chapter": 44,
            "verse": 52,
            "text": "في جنات وعيون"
        },
        {
            "chapter": 44,
            "verse": 53,
            "text": "يلبسون من سندس واستبرق متقابلين"
        },
        {
            "chapter": 44,
            "verse": 54,
            "text": "كذلك وزوجناهم بحور عين"
        },
        {
            "chapter": 44,
            "verse": 55,
            "text": "يدعون فيها بكل فاكهة امنين"
        },
        {
            "chapter": 44,
            "verse": 56,
            "text": "لا يذوقون فيها الموت الا الموتة الاولى ووقاهم عذاب الجحيم"
        },
        {
            "chapter": 44,
            "verse": 57,
            "text": "فضلا من ربك ذلك هو الفوز العظيم"
        },
        {
            "chapter": 44,
            "verse": 58,
            "text": "فانما يسرناه بلسانك لعلهم يتذكرون"
        },
        {
            "chapter": 44,
            "verse": 59,
            "text": "فارتقب انهم مرتقبون"
        },
        {
            "chapter": 45,
            "verse": 1,
            "text": "حم"
        },
        {
            "chapter": 45,
            "verse": 2,
            "text": "تنزيل الكتاب من الله العزيز الحكيم"
        },
        {
            "chapter": 45,
            "verse": 3,
            "text": "ان في السماوات والارض لايات للمومنين"
        },
        {
            "chapter": 45,
            "verse": 4,
            "text": "وفي خلقكم وما يبث من دابة ايات لقوم يوقنون"
        },
        {
            "chapter": 45,
            "verse": 5,
            "text": "واختلاف الليل والنهار وما انزل الله من السماء من رزق فاحيا به الارض بعد موتها وتصريف الرياح ايات لقوم يعقلون"
        },
        {
            "chapter": 45,
            "verse": 6,
            "text": "تلك ايات الله نتلوها عليك بالحق فباي حديث بعد الله واياته يومنون"
        },
        {
            "chapter": 45,
            "verse": 7,
            "text": "ويل لكل افاك اثيم"
        },
        {
            "chapter": 45,
            "verse": 8,
            "text": "يسمع ايات الله تتلى عليه ثم يصر مستكبرا كان لم يسمعها فبشره بعذاب اليم"
        },
        {
            "chapter": 45,
            "verse": 9,
            "text": "واذا علم من اياتنا شييا اتخذها هزوا اوليك لهم عذاب مهين"
        },
        {
            "chapter": 45,
            "verse": 10,
            "text": "من ورايهم جهنم ولا يغني عنهم ما كسبوا شييا ولا ما اتخذوا من دون الله اولياء ولهم عذاب عظيم"
        },
        {
            "chapter": 45,
            "verse": 11,
            "text": "هذا هدى والذين كفروا بايات ربهم لهم عذاب من رجز اليم"
        }
    ]
}