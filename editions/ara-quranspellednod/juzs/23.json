{
    "juzs": [
        {
            "chapter": 36,
            "verse": 28,
            "text": "وما انزلنا على قومه من بعده من جند من السماء وما كنا منزلين"
        },
        {
            "chapter": 36,
            "verse": 29,
            "text": "ان كانت الا صيحة واحدة فاذا هم خامدون"
        },
        {
            "chapter": 36,
            "verse": 30,
            "text": "يا حسرة على العباد ما ياتيهم من رسول الا كانوا به يستهزيون"
        },
        {
            "chapter": 36,
            "verse": 31,
            "text": "الم يروا كم اهلكنا قبلهم من القرون انهم اليهم لا يرجعون"
        },
        {
            "chapter": 36,
            "verse": 32,
            "text": "وان كل لما جميع لدينا محضرون"
        },
        {
            "chapter": 36,
            "verse": 33,
            "text": "واية لهم الارض الميتة احييناها واخرجنا منها حبا فمنه ياكلون"
        },
        {
            "chapter": 36,
            "verse": 34,
            "text": "وجعلنا فيها جنات من نخيل واعناب وفجرنا فيها من العيون"
        },
        {
            "chapter": 36,
            "verse": 35,
            "text": "لياكلوا من ثمره وما عملته ايديهم افلا يشكرون"
        },
        {
            "chapter": 36,
            "verse": 36,
            "text": "سبحان الذي خلق الازواج كلها مما تنبت الارض ومن انفسهم ومما لا يعلمون"
        },
        {
            "chapter": 36,
            "verse": 37,
            "text": "واية لهم الليل نسلخ منه النهار فاذا هم مظلمون"
        },
        {
            "chapter": 36,
            "verse": 38,
            "text": "والشمس تجري لمستقر لها ذلك تقدير العزيز العليم"
        },
        {
            "chapter": 36,
            "verse": 39,
            "text": "والقمر قدرناه منازل حتى عاد كالعرجون القديم"
        },
        {
            "chapter": 36,
            "verse": 40,
            "text": "لا الشمس ينبغي لها ان تدرك القمر ولا الليل سابق النهار وكل في فلك يسبحون"
        },
        {
            "chapter": 36,
            "verse": 41,
            "text": "واية لهم انا حملنا ذريتهم في الفلك المشحون"
        },
        {
            "chapter": 36,
            "verse": 42,
            "text": "وخلقنا لهم من مثله ما يركبون"
        },
        {
            "chapter": 36,
            "verse": 43,
            "text": "وان نشا نغرقهم فلا صريخ لهم ولا هم ينقذون"
        },
        {
            "chapter": 36,
            "verse": 44,
            "text": "الا رحمة منا ومتاعا الى حين"
        },
        {
            "chapter": 36,
            "verse": 45,
            "text": "واذا قيل لهم اتقوا ما بين ايديكم وما خلفكم لعلكم ترحمون"
        },
        {
            "chapter": 36,
            "verse": 46,
            "text": "وما تاتيهم من اية من ايات ربهم الا كانوا عنها معرضين"
        },
        {
            "chapter": 36,
            "verse": 47,
            "text": "واذا قيل لهم انفقوا مما رزقكم الله قال الذين كفروا للذين امنوا انطعم من لو يشاء الله اطعمه ان انتم الا في ضلال مبين"
        },
        {
            "chapter": 36,
            "verse": 48,
            "text": "ويقولون متى هذا الوعد ان كنتم صادقين"
        },
        {
            "chapter": 36,
            "verse": 49,
            "text": "ما ينظرون الا صيحة واحدة تاخذهم وهم يخصمون"
        },
        {
            "chapter": 36,
            "verse": 50,
            "text": "فلا يستطيعون توصية ولا الى اهلهم يرجعون"
        },
        {
            "chapter": 36,
            "verse": 51,
            "text": "ونفخ في الصور فاذا هم من الاجداث الى ربهم ينسلون"
        },
        {
            "chapter": 36,
            "verse": 52,
            "text": "قالوا يا ويلنا من بعثنا من مرقدنا هذا ما وعد الرحمن وصدق المرسلون"
        },
        {
            "chapter": 36,
            "verse": 53,
            "text": "ان كانت الا صيحة واحدة فاذا هم جميع لدينا محضرون"
        },
        {
            "chapter": 36,
            "verse": 54,
            "text": "فاليوم لا تظلم نفس شييا ولا تجزون الا ما كنتم تعملون"
        },
        {
            "chapter": 36,
            "verse": 55,
            "text": "ان اصحاب الجنة اليوم في شغل فاكهون"
        },
        {
            "chapter": 36,
            "verse": 56,
            "text": "هم وازواجهم في ظلال على الارايك متكيون"
        },
        {
            "chapter": 36,
            "verse": 57,
            "text": "لهم فيها فاكهة ولهم ما يدعون"
        },
        {
            "chapter": 36,
            "verse": 58,
            "text": "سلام قولا من رب رحيم"
        },
        {
            "chapter": 36,
            "verse": 59,
            "text": "وامتازوا اليوم ايها المجرمون"
        },
        {
            "chapter": 36,
            "verse": 60,
            "text": "الم اعهد اليكم يا بني ادم ان لا تعبدوا الشيطان انه لكم عدو مبين"
        },
        {
            "chapter": 36,
            "verse": 61,
            "text": "وان اعبدوني هذا صراط مستقيم"
        },
        {
            "chapter": 36,
            "verse": 62,
            "text": "ولقد اضل منكم جبلا كثيرا افلم تكونوا تعقلون"
        },
        {
            "chapter": 36,
            "verse": 63,
            "text": "هذه جهنم التي كنتم توعدون"
        },
        {
            "chapter": 36,
            "verse": 64,
            "text": "اصلوها اليوم بما كنتم تكفرون"
        },
        {
            "chapter": 36,
            "verse": 65,
            "text": "اليوم نختم على افواههم وتكلمنا ايديهم وتشهد ارجلهم بما كانوا يكسبون"
        },
        {
            "chapter": 36,
            "verse": 66,
            "text": "ولو نشاء لطمسنا على اعينهم فاستبقوا الصراط فانى يبصرون"
        },
        {
            "chapter": 36,
            "verse": 67,
            "text": "ولو نشاء لمسخناهم على مكانتهم فما استطاعوا مضيا ولا يرجعون"
        },
        {
            "chapter": 36,
            "verse": 68,
            "text": "ومن نعمره ننكسه في الخلق افلا يعقلون"
        },
        {
            "chapter": 36,
            "verse": 69,
            "text": "وما علمناه الشعر وما ينبغي له ان هو الا ذكر وقران مبين"
        },
        {
            "chapter": 36,
            "verse": 70,
            "text": "لينذر من كان حيا ويحق القول على الكافرين"
        },
        {
            "chapter": 36,
            "verse": 71,
            "text": "اولم يروا انا خلقنا لهم مما عملت ايدينا انعاما فهم لها مالكون"
        },
        {
            "chapter": 36,
            "verse": 72,
            "text": "وذللناها لهم فمنها ركوبهم ومنها ياكلون"
        },
        {
            "chapter": 36,
            "verse": 73,
            "text": "ولهم فيها منافع ومشارب افلا يشكرون"
        },
        {
            "chapter": 36,
            "verse": 74,
            "text": "واتخذوا من دون الله الهة لعلهم ينصرون"
        },
        {
            "chapter": 36,
            "verse": 75,
            "text": "لا يستطيعون نصرهم وهم لهم جند محضرون"
        },
        {
            "chapter": 36,
            "verse": 76,
            "text": "فلا يحزنك قولهم انا نعلم ما يسرون وما يعلنون"
        },
        {
            "chapter": 36,
            "verse": 77,
            "text": "اولم ير الانسان انا خلقناه من نطفة فاذا هو خصيم مبين"
        },
        {
            "chapter": 36,
            "verse": 78,
            "text": "وضرب لنا مثلا ونسي خلقه قال من يحيي العظام وهي رميم"
        },
        {
            "chapter": 36,
            "verse": 79,
            "text": "قل يحييها الذي انشاها اول مرة وهو بكل خلق عليم"
        },
        {
            "chapter": 36,
            "verse": 80,
            "text": "الذي جعل لكم من الشجر الاخضر نارا فاذا انتم منه توقدون"
        },
        {
            "chapter": 36,
            "verse": 81,
            "text": "اوليس الذي خلق السماوات والارض بقادر على ان يخلق مثلهم بلى وهو الخلاق العليم"
        },
        {
            "chapter": 36,
            "verse": 82,
            "text": "انما امره اذا اراد شييا ان يقول له كن فيكون"
        },
        {
            "chapter": 36,
            "verse": 83,
            "text": "فسبحان الذي بيده ملكوت كل شيء واليه ترجعون"
        },
        {
            "chapter": 37,
            "verse": 1,
            "text": "والصافات صفا"
        },
        {
            "chapter": 37,
            "verse": 2,
            "text": "فالزاجرات زجرا"
        },
        {
            "chapter": 37,
            "verse": 3,
            "text": "فالتاليات ذكرا"
        },
        {
            "chapter": 37,
            "verse": 4,
            "text": "ان الهكم لواحد"
        },
        {
            "chapter": 37,
            "verse": 5,
            "text": "رب السماوات والارض وما بينهما ورب المشارق"
        },
        {
            "chapter": 37,
            "verse": 6,
            "text": "انا زينا السماء الدنيا بزينة الكواكب"
        },
        {
            "chapter": 37,
            "verse": 7,
            "text": "وحفظا من كل شيطان مارد"
        },
        {
            "chapter": 37,
            "verse": 8,
            "text": "لا يسمعون الى الملا الاعلى ويقذفون من كل جانب"
        },
        {
            "chapter": 37,
            "verse": 9,
            "text": "دحورا ولهم عذاب واصب"
        },
        {
            "chapter": 37,
            "verse": 10,
            "text": "الا من خطف الخطفة فاتبعه شهاب ثاقب"
        },
        {
            "chapter": 37,
            "verse": 11,
            "text": "فاستفتهم اهم اشد خلقا ام من خلقنا انا خلقناهم من طين لازب"
        },
        {
            "chapter": 37,
            "verse": 12,
            "text": "بل عجبت ويسخرون"
        },
        {
            "chapter": 37,
            "verse": 13,
            "text": "واذا ذكروا لا يذكرون"
        },
        {
            "chapter": 37,
            "verse": 14,
            "text": "واذا راوا اية يستسخرون"
        },
        {
            "chapter": 37,
            "verse": 15,
            "text": "وقالوا ان هذا الا سحر مبين"
        },
        {
            "chapter": 37,
            "verse": 16,
            "text": "ااذا متنا وكنا ترابا وعظاما اانا لمبعوثون"
        },
        {
            "chapter": 37,
            "verse": 17,
            "text": "اواباونا الاولون"
        },
        {
            "chapter": 37,
            "verse": 18,
            "text": "قل نعم وانتم داخرون"
        },
        {
            "chapter": 37,
            "verse": 19,
            "text": "فانما هي زجرة واحدة فاذا هم ينظرون"
        },
        {
            "chapter": 37,
            "verse": 20,
            "text": "وقالوا يا ويلنا هذا يوم الدين"
        },
        {
            "chapter": 37,
            "verse": 21,
            "text": "هذا يوم الفصل الذي كنتم به تكذبون"
        },
        {
            "chapter": 37,
            "verse": 22,
            "text": "احشروا الذين ظلموا وازواجهم وما كانوا يعبدون"
        },
        {
            "chapter": 37,
            "verse": 23,
            "text": "من دون الله فاهدوهم الى صراط الجحيم"
        },
        {
            "chapter": 37,
            "verse": 24,
            "text": "وقفوهم انهم مسيولون"
        },
        {
            "chapter": 37,
            "verse": 25,
            "text": "ما لكم لا تناصرون"
        },
        {
            "chapter": 37,
            "verse": 26,
            "text": "بل هم اليوم مستسلمون"
        },
        {
            "chapter": 37,
            "verse": 27,
            "text": "واقبل بعضهم على بعض يتساءلون"
        },
        {
            "chapter": 37,
            "verse": 28,
            "text": "قالوا انكم كنتم تاتوننا عن اليمين"
        },
        {
            "chapter": 37,
            "verse": 29,
            "text": "قالوا بل لم تكونوا مومنين"
        },
        {
            "chapter": 37,
            "verse": 30,
            "text": "وما كان لنا عليكم من سلطان بل كنتم قوما طاغين"
        },
        {
            "chapter": 37,
            "verse": 31,
            "text": "فحق علينا قول ربنا انا لذايقون"
        },
        {
            "chapter": 37,
            "verse": 32,
            "text": "فاغويناكم انا كنا غاوين"
        },
        {
            "chapter": 37,
            "verse": 33,
            "text": "فانهم يوميذ في العذاب مشتركون"
        },
        {
            "chapter": 37,
            "verse": 34,
            "text": "انا كذلك نفعل بالمجرمين"
        },
        {
            "chapter": 37,
            "verse": 35,
            "text": "انهم كانوا اذا قيل لهم لا اله الا الله يستكبرون"
        },
        {
            "chapter": 37,
            "verse": 36,
            "text": "ويقولون اينا لتاركو الهتنا لشاعر مجنون"
        },
        {
            "chapter": 37,
            "verse": 37,
            "text": "بل جاء بالحق وصدق المرسلين"
        },
        {
            "chapter": 37,
            "verse": 38,
            "text": "انكم لذايقو العذاب الاليم"
        },
        {
            "chapter": 37,
            "verse": 39,
            "text": "وما تجزون الا ما كنتم تعملون"
        },
        {
            "chapter": 37,
            "verse": 40,
            "text": "الا عباد الله المخلصين"
        },
        {
            "chapter": 37,
            "verse": 41,
            "text": "اوليك لهم رزق معلوم"
        },
        {
            "chapter": 37,
            "verse": 42,
            "text": "فواكه وهم مكرمون"
        },
        {
            "chapter": 37,
            "verse": 43,
            "text": "في جنات النعيم"
        },
        {
            "chapter": 37,
            "verse": 44,
            "text": "على سرر متقابلين"
        },
        {
            "chapter": 37,
            "verse": 45,
            "text": "يطاف عليهم بكاس من معين"
        },
        {
            "chapter": 37,
            "verse": 46,
            "text": "بيضاء لذة للشاربين"
        },
        {
            "chapter": 37,
            "verse": 47,
            "text": "لا فيها غول ولا هم عنها ينزفون"
        },
        {
            "chapter": 37,
            "verse": 48,
            "text": "وعندهم قاصرات الطرف عين"
        },
        {
            "chapter": 37,
            "verse": 49,
            "text": "كانهن بيض مكنون"
        },
        {
            "chapter": 37,
            "verse": 50,
            "text": "فاقبل بعضهم على بعض يتساءلون"
        },
        {
            "chapter": 37,
            "verse": 51,
            "text": "قال قايل منهم اني كان لي قرين"
        },
        {
            "chapter": 37,
            "verse": 52,
            "text": "يقول اانك لمن المصدقين"
        },
        {
            "chapter": 37,
            "verse": 53,
            "text": "ااذا متنا وكنا ترابا وعظاما اانا لمدينون"
        },
        {
            "chapter": 37,
            "verse": 54,
            "text": "قال هل انتم مطلعون"
        },
        {
            "chapter": 37,
            "verse": 55,
            "text": "فاطلع فراه في سواء الجحيم"
        },
        {
            "chapter": 37,
            "verse": 56,
            "text": "قال تالله ان كدت لتردين"
        },
        {
            "chapter": 37,
            "verse": 57,
            "text": "ولولا نعمة ربي لكنت من المحضرين"
        },
        {
            "chapter": 37,
            "verse": 58,
            "text": "افما نحن بميتين"
        },
        {
            "chapter": 37,
            "verse": 59,
            "text": "الا موتتنا الاولى وما نحن بمعذبين"
        },
        {
            "chapter": 37,
            "verse": 60,
            "text": "ان هذا لهو الفوز العظيم"
        },
        {
            "chapter": 37,
            "verse": 61,
            "text": "لمثل هذا فليعمل العاملون"
        },
        {
            "chapter": 37,
            "verse": 62,
            "text": "اذلك خير نزلا ام شجرة الزقوم"
        },
        {
            "chapter": 37,
            "verse": 63,
            "text": "انا جعلناها فتنة للظالمين"
        },
        {
            "chapter": 37,
            "verse": 64,
            "text": "انها شجرة تخرج في اصل الجحيم"
        },
        {
            "chapter": 37,
            "verse": 65,
            "text": "طلعها كانه رءوس الشياطين"
        },
        {
            "chapter": 37,
            "verse": 66,
            "text": "فانهم لاكلون منها فماليون منها البطون"
        },
        {
            "chapter": 37,
            "verse": 67,
            "text": "ثم ان لهم عليها لشوبا من حميم"
        },
        {
            "chapter": 37,
            "verse": 68,
            "text": "ثم ان مرجعهم لالى الجحيم"
        },
        {
            "chapter": 37,
            "verse": 69,
            "text": "انهم الفوا اباءهم ضالين"
        },
        {
            "chapter": 37,
            "verse": 70,
            "text": "فهم على اثارهم يهرعون"
        },
        {
            "chapter": 37,
            "verse": 71,
            "text": "ولقد ضل قبلهم اكثر الاولين"
        },
        {
            "chapter": 37,
            "verse": 72,
            "text": "ولقد ارسلنا فيهم منذرين"
        },
        {
            "chapter": 37,
            "verse": 73,
            "text": "فانظر كيف كان عاقبة المنذرين"
        },
        {
            "chapter": 37,
            "verse": 74,
            "text": "الا عباد الله المخلصين"
        },
        {
            "chapter": 37,
            "verse": 75,
            "text": "ولقد نادانا نوح فلنعم المجيبون"
        },
        {
            "chapter": 37,
            "verse": 76,
            "text": "ونجيناه واهله من الكرب العظيم"
        },
        {
            "chapter": 37,
            "verse": 77,
            "text": "وجعلنا ذريته هم الباقين"
        },
        {
            "chapter": 37,
            "verse": 78,
            "text": "وتركنا عليه في الاخرين"
        },
        {
            "chapter": 37,
            "verse": 79,
            "text": "سلام على نوح في العالمين"
        },
        {
            "chapter": 37,
            "verse": 80,
            "text": "انا كذلك نجزي المحسنين"
        },
        {
            "chapter": 37,
            "verse": 81,
            "text": "انه من عبادنا المومنين"
        },
        {
            "chapter": 37,
            "verse": 82,
            "text": "ثم اغرقنا الاخرين"
        },
        {
            "chapter": 37,
            "verse": 83,
            "text": "وان من شيعته لابراهيم"
        },
        {
            "chapter": 37,
            "verse": 84,
            "text": "اذ جاء ربه بقلب سليم"
        },
        {
            "chapter": 37,
            "verse": 85,
            "text": "اذ قال لابيه وقومه ماذا تعبدون"
        },
        {
            "chapter": 37,
            "verse": 86,
            "text": "ايفكا الهة دون الله تريدون"
        },
        {
            "chapter": 37,
            "verse": 87,
            "text": "فما ظنكم برب العالمين"
        },
        {
            "chapter": 37,
            "verse": 88,
            "text": "فنظر نظرة في النجوم"
        },
        {
            "chapter": 37,
            "verse": 89,
            "text": "فقال اني سقيم"
        },
        {
            "chapter": 37,
            "verse": 90,
            "text": "فتولوا عنه مدبرين"
        },
        {
            "chapter": 37,
            "verse": 91,
            "text": "فراغ الى الهتهم فقال الا تاكلون"
        },
        {
            "chapter": 37,
            "verse": 92,
            "text": "ما لكم لا تنطقون"
        },
        {
            "chapter": 37,
            "verse": 93,
            "text": "فراغ عليهم ضربا باليمين"
        },
        {
            "chapter": 37,
            "verse": 94,
            "text": "فاقبلوا اليه يزفون"
        },
        {
            "chapter": 37,
            "verse": 95,
            "text": "قال اتعبدون ما تنحتون"
        },
        {
            "chapter": 37,
            "verse": 96,
            "text": "والله خلقكم وما تعملون"
        },
        {
            "chapter": 37,
            "verse": 97,
            "text": "قالوا ابنوا له بنيانا فالقوه في الجحيم"
        },
        {
            "chapter": 37,
            "verse": 98,
            "text": "فارادوا به كيدا فجعلناهم الاسفلين"
        },
        {
            "chapter": 37,
            "verse": 99,
            "text": "وقال اني ذاهب الى ربي سيهدين"
        },
        {
            "chapter": 37,
            "verse": 100,
            "text": "رب هب لي من الصالحين"
        },
        {
            "chapter": 37,
            "verse": 101,
            "text": "فبشرناه بغلام حليم"
        },
        {
            "chapter": 37,
            "verse": 102,
            "text": "فلما بلغ معه السعي قال يا بني اني ارى في المنام اني اذبحك فانظر ماذا ترى قال يا ابت افعل ما تومر ستجدني ان شاء الله من الصابرين"
        },
        {
            "chapter": 37,
            "verse": 103,
            "text": "فلما اسلما وتله للجبين"
        },
        {
            "chapter": 37,
            "verse": 104,
            "text": "وناديناه ان يا ابراهيم"
        },
        {
            "chapter": 37,
            "verse": 105,
            "text": "قد صدقت الرويا انا كذلك نجزي المحسنين"
        },
        {
            "chapter": 37,
            "verse": 106,
            "text": "ان هذا لهو البلاء المبين"
        },
        {
            "chapter": 37,
            "verse": 107,
            "text": "وفديناه بذبح عظيم"
        },
        {
            "chapter": 37,
            "verse": 108,
            "text": "وتركنا عليه في الاخرين"
        },
        {
            "chapter": 37,
            "verse": 109,
            "text": "سلام على ابراهيم"
        },
        {
            "chapter": 37,
            "verse": 110,
            "text": "كذلك نجزي المحسنين"
        },
        {
            "chapter": 37,
            "verse": 111,
            "text": "انه من عبادنا المومنين"
        },
        {
            "chapter": 37,
            "verse": 112,
            "text": "وبشرناه باسحاق نبيا من الصالحين"
        },
        {
            "chapter": 37,
            "verse": 113,
            "text": "وباركنا عليه وعلى اسحاق ومن ذريتهما محسن وظالم لنفسه مبين"
        },
        {
            "chapter": 37,
            "verse": 114,
            "text": "ولقد مننا على موسى وهارون"
        },
        {
            "chapter": 37,
            "verse": 115,
            "text": "ونجيناهما وقومهما من الكرب العظيم"
        },
        {
            "chapter": 37,
            "verse": 116,
            "text": "ونصرناهم فكانوا هم الغالبين"
        },
        {
            "chapter": 37,
            "verse": 117,
            "text": "واتيناهما الكتاب المستبين"
        },
        {
            "chapter": 37,
            "verse": 118,
            "text": "وهديناهما الصراط المستقيم"
        },
        {
            "chapter": 37,
            "verse": 119,
            "text": "وتركنا عليهما في الاخرين"
        },
        {
            "chapter": 37,
            "verse": 120,
            "text": "سلام على موسى وهارون"
        },
        {
            "chapter": 37,
            "verse": 121,
            "text": "انا كذلك نجزي المحسنين"
        },
        {
            "chapter": 37,
            "verse": 122,
            "text": "انهما من عبادنا المومنين"
        },
        {
            "chapter": 37,
            "verse": 123,
            "text": "وان الياس لمن المرسلين"
        },
        {
            "chapter": 37,
            "verse": 124,
            "text": "اذ قال لقومه الا تتقون"
        },
        {
            "chapter": 37,
            "verse": 125,
            "text": "اتدعون بعلا وتذرون احسن الخالقين"
        },
        {
            "chapter": 37,
            "verse": 126,
            "text": "الله ربكم ورب ابايكم الاولين"
        },
        {
            "chapter": 37,
            "verse": 127,
            "text": "فكذبوه فانهم لمحضرون"
        },
        {
            "chapter": 37,
            "verse": 128,
            "text": "الا عباد الله المخلصين"
        },
        {
            "chapter": 37,
            "verse": 129,
            "text": "وتركنا عليه في الاخرين"
        },
        {
            "chapter": 37,
            "verse": 130,
            "text": "سلام على ال ياسين"
        },
        {
            "chapter": 37,
            "verse": 131,
            "text": "انا كذلك نجزي المحسنين"
        },
        {
            "chapter": 37,
            "verse": 132,
            "text": "انه من عبادنا المومنين"
        },
        {
            "chapter": 37,
            "verse": 133,
            "text": "وان لوطا لمن المرسلين"
        },
        {
            "chapter": 37,
            "verse": 134,
            "text": "اذ نجيناه واهله اجمعين"
        },
        {
            "chapter": 37,
            "verse": 135,
            "text": "الا عجوزا في الغابرين"
        },
        {
            "chapter": 37,
            "verse": 136,
            "text": "ثم دمرنا الاخرين"
        },
        {
            "chapter": 37,
            "verse": 137,
            "text": "وانكم لتمرون عليهم مصبحين"
        },
        {
            "chapter": 37,
            "verse": 138,
            "text": "وبالليل افلا تعقلون"
        },
        {
            "chapter": 37,
            "verse": 139,
            "text": "وان يونس لمن المرسلين"
        },
        {
            "chapter": 37,
            "verse": 140,
            "text": "اذ ابق الى الفلك المشحون"
        },
        {
            "chapter": 37,
            "verse": 141,
            "text": "فساهم فكان من المدحضين"
        },
        {
            "chapter": 37,
            "verse": 142,
            "text": "فالتقمه الحوت وهو مليم"
        },
        {
            "chapter": 37,
            "verse": 143,
            "text": "فلولا انه كان من المسبحين"
        },
        {
            "chapter": 37,
            "verse": 144,
            "text": "للبث في بطنه الى يوم يبعثون"
        },
        {
            "chapter": 37,
            "verse": 145,
            "text": "فنبذناه بالعراء وهو سقيم"
        },
        {
            "chapter": 37,
            "verse": 146,
            "text": "وانبتنا عليه شجرة من يقطين"
        },
        {
            "chapter": 37,
            "verse": 147,
            "text": "وارسلناه الى ماية الف او يزيدون"
        },
        {
            "chapter": 37,
            "verse": 148,
            "text": "فامنوا فمتعناهم الى حين"
        },
        {
            "chapter": 37,
            "verse": 149,
            "text": "فاستفتهم الربك البنات ولهم البنون"
        },
        {
            "chapter": 37,
            "verse": 150,
            "text": "ام خلقنا الملايكة اناثا وهم شاهدون"
        },
        {
            "chapter": 37,
            "verse": 151,
            "text": "الا انهم من افكهم ليقولون"
        },
        {
            "chapter": 37,
            "verse": 152,
            "text": "ولد الله وانهم لكاذبون"
        },
        {
            "chapter": 37,
            "verse": 153,
            "text": "اصطفى البنات على البنين"
        },
        {
            "chapter": 37,
            "verse": 154,
            "text": "ما لكم كيف تحكمون"
        },
        {
            "chapter": 37,
            "verse": 155,
            "text": "افلا تذكرون"
        },
        {
            "chapter": 37,
            "verse": 156,
            "text": "ام لكم سلطان مبين"
        },
        {
            "chapter": 37,
            "verse": 157,
            "text": "فاتوا بكتابكم ان كنتم صادقين"
        },
        {
            "chapter": 37,
            "verse": 158,
            "text": "وجعلوا بينه وبين الجنة نسبا ولقد علمت الجنة انهم لمحضرون"
        },
        {
            "chapter": 37,
            "verse": 159,
            "text": "سبحان الله عما يصفون"
        },
        {
            "chapter": 37,
            "verse": 160,
            "text": "الا عباد الله المخلصين"
        },
        {
            "chapter": 37,
            "verse": 161,
            "text": "فانكم وما تعبدون"
        },
        {
            "chapter": 37,
            "verse": 162,
            "text": "ما انتم عليه بفاتنين"
        },
        {
            "chapter": 37,
            "verse": 163,
            "text": "الا من هو صال الجحيم"
        },
        {
            "chapter": 37,
            "verse": 164,
            "text": "وما منا الا له مقام معلوم"
        },
        {
            "chapter": 37,
            "verse": 165,
            "text": "وانا لنحن الصافون"
        },
        {
            "chapter": 37,
            "verse": 166,
            "text": "وانا لنحن المسبحون"
        },
        {
            "chapter": 37,
            "verse": 167,
            "text": "وان كانوا ليقولون"
        },
        {
            "chapter": 37,
            "verse": 168,
            "text": "لو ان عندنا ذكرا من الاولين"
        },
        {
            "chapter": 37,
            "verse": 169,
            "text": "لكنا عباد الله المخلصين"
        },
        {
            "chapter": 37,
            "verse": 170,
            "text": "فكفروا به فسوف يعلمون"
        },
        {
            "chapter": 37,
            "verse": 171,
            "text": "ولقد سبقت كلمتنا لعبادنا المرسلين"
        },
        {
            "chapter": 37,
            "verse": 172,
            "text": "انهم لهم المنصورون"
        },
        {
            "chapter": 37,
            "verse": 173,
            "text": "وان جندنا لهم الغالبون"
        },
        {
            "chapter": 37,
            "verse": 174,
            "text": "فتول عنهم حتى حين"
        },
        {
            "chapter": 37,
            "verse": 175,
            "text": "وابصرهم فسوف يبصرون"
        },
        {
            "chapter": 37,
            "verse": 176,
            "text": "افبعذابنا يستعجلون"
        },
        {
            "chapter": 37,
            "verse": 177,
            "text": "فاذا نزل بساحتهم فساء صباح المنذرين"
        },
        {
            "chapter": 37,
            "verse": 178,
            "text": "وتول عنهم حتى حين"
        },
        {
            "chapter": 37,
            "verse": 179,
            "text": "وابصر فسوف يبصرون"
        },
        {
            "chapter": 37,
            "verse": 180,
            "text": "سبحان ربك رب العزة عما يصفون"
        },
        {
            "chapter": 37,
            "verse": 181,
            "text": "وسلام على المرسلين"
        },
        {
            "chapter": 37,
            "verse": 182,
            "text": "والحمد لله رب العالمين"
        },
        {
            "chapter": 38,
            "verse": 1,
            "text": "ص والقران ذي الذكر"
        },
        {
            "chapter": 38,
            "verse": 2,
            "text": "بل الذين كفروا في عزة وشقاق"
        },
        {
            "chapter": 38,
            "verse": 3,
            "text": "كم اهلكنا من قبلهم من قرن فنادوا ولات حين مناص"
        },
        {
            "chapter": 38,
            "verse": 4,
            "text": "وعجبوا ان جاءهم منذر منهم وقال الكافرون هذا ساحر كذاب"
        },
        {
            "chapter": 38,
            "verse": 5,
            "text": "اجعل الالهة الها واحدا ان هذا لشيء عجاب"
        },
        {
            "chapter": 38,
            "verse": 6,
            "text": "وانطلق الملا منهم ان امشوا واصبروا على الهتكم ان هذا لشيء يراد"
        },
        {
            "chapter": 38,
            "verse": 7,
            "text": "ما سمعنا بهذا في الملة الاخرة ان هذا الا اختلاق"
        },
        {
            "chapter": 38,
            "verse": 8,
            "text": "اانزل عليه الذكر من بيننا بل هم في شك من ذكري بل لما يذوقوا عذاب"
        },
        {
            "chapter": 38,
            "verse": 9,
            "text": "ام عندهم خزاين رحمة ربك العزيز الوهاب"
        },
        {
            "chapter": 38,
            "verse": 10,
            "text": "ام لهم ملك السماوات والارض وما بينهما فليرتقوا في الاسباب"
        },
        {
            "chapter": 38,
            "verse": 11,
            "text": "جند ما هنالك مهزوم من الاحزاب"
        },
        {
            "chapter": 38,
            "verse": 12,
            "text": "كذبت قبلهم قوم نوح وعاد وفرعون ذو الاوتاد"
        },
        {
            "chapter": 38,
            "verse": 13,
            "text": "وثمود وقوم لوط واصحاب الايكة اوليك الاحزاب"
        },
        {
            "chapter": 38,
            "verse": 14,
            "text": "ان كل الا كذب الرسل فحق عقاب"
        },
        {
            "chapter": 38,
            "verse": 15,
            "text": "وما ينظر هولاء الا صيحة واحدة ما لها من فواق"
        },
        {
            "chapter": 38,
            "verse": 16,
            "text": "وقالوا ربنا عجل لنا قطنا قبل يوم الحساب"
        },
        {
            "chapter": 38,
            "verse": 17,
            "text": "اصبر على ما يقولون واذكر عبدنا داوود ذا الايد انه اواب"
        },
        {
            "chapter": 38,
            "verse": 18,
            "text": "انا سخرنا الجبال معه يسبحن بالعشي والاشراق"
        },
        {
            "chapter": 38,
            "verse": 19,
            "text": "والطير محشورة كل له اواب"
        },
        {
            "chapter": 38,
            "verse": 20,
            "text": "وشددنا ملكه واتيناه الحكمة وفصل الخطاب"
        },
        {
            "chapter": 38,
            "verse": 21,
            "text": "وهل اتاك نبا الخصم اذ تسوروا المحراب"
        },
        {
            "chapter": 38,
            "verse": 22,
            "text": "اذ دخلوا على داوود ففزع منهم قالوا لا تخف خصمان بغى بعضنا على بعض فاحكم بيننا بالحق ولا تشطط واهدنا الى سواء الصراط"
        },
        {
            "chapter": 38,
            "verse": 23,
            "text": "ان هذا اخي له تسع وتسعون نعجة ولي نعجة واحدة فقال اكفلنيها وعزني في الخطاب"
        },
        {
            "chapter": 38,
            "verse": 24,
            "text": "قال لقد ظلمك بسوال نعجتك الى نعاجه وان كثيرا من الخلطاء ليبغي بعضهم على بعض الا الذين امنوا وعملوا الصالحات وقليل ما هم وظن داوود انما فتناه فاستغفر ربه وخر راكعا واناب"
        },
        {
            "chapter": 38,
            "verse": 25,
            "text": "فغفرنا له ذلك وان له عندنا لزلفى وحسن ماب"
        },
        {
            "chapter": 38,
            "verse": 26,
            "text": "يا داوود انا جعلناك خليفة في الارض فاحكم بين الناس بالحق ولا تتبع الهوى فيضلك عن سبيل الله ان الذين يضلون عن سبيل الله لهم عذاب شديد بما نسوا يوم الحساب"
        },
        {
            "chapter": 38,
            "verse": 27,
            "text": "وما خلقنا السماء والارض وما بينهما باطلا ذلك ظن الذين كفروا فويل للذين كفروا من النار"
        },
        {
            "chapter": 38,
            "verse": 28,
            "text": "ام نجعل الذين امنوا وعملوا الصالحات كالمفسدين في الارض ام نجعل المتقين كالفجار"
        },
        {
            "chapter": 38,
            "verse": 29,
            "text": "كتاب انزلناه اليك مبارك ليدبروا اياته وليتذكر اولو الالباب"
        },
        {
            "chapter": 38,
            "verse": 30,
            "text": "ووهبنا لداوود سليمان نعم العبد انه اواب"
        },
        {
            "chapter": 38,
            "verse": 31,
            "text": "اذ عرض عليه بالعشي الصافنات الجياد"
        },
        {
            "chapter": 38,
            "verse": 32,
            "text": "فقال اني احببت حب الخير عن ذكر ربي حتى توارت بالحجاب"
        },
        {
            "chapter": 38,
            "verse": 33,
            "text": "ردوها علي فطفق مسحا بالسوق والاعناق"
        },
        {
            "chapter": 38,
            "verse": 34,
            "text": "ولقد فتنا سليمان والقينا على كرسيه جسدا ثم اناب"
        },
        {
            "chapter": 38,
            "verse": 35,
            "text": "قال رب اغفر لي وهب لي ملكا لا ينبغي لاحد من بعدي انك انت الوهاب"
        },
        {
            "chapter": 38,
            "verse": 36,
            "text": "فسخرنا له الريح تجري بامره رخاء حيث اصاب"
        },
        {
            "chapter": 38,
            "verse": 37,
            "text": "والشياطين كل بناء وغواص"
        },
        {
            "chapter": 38,
            "verse": 38,
            "text": "واخرين مقرنين في الاصفاد"
        },
        {
            "chapter": 38,
            "verse": 39,
            "text": "هذا عطاونا فامنن او امسك بغير حساب"
        },
        {
            "chapter": 38,
            "verse": 40,
            "text": "وان له عندنا لزلفى وحسن ماب"
        },
        {
            "chapter": 38,
            "verse": 41,
            "text": "واذكر عبدنا ايوب اذ نادى ربه اني مسني الشيطان بنصب وعذاب"
        },
        {
            "chapter": 38,
            "verse": 42,
            "text": "اركض برجلك هذا مغتسل بارد وشراب"
        },
        {
            "chapter": 38,
            "verse": 43,
            "text": "ووهبنا له اهله ومثلهم معهم رحمة منا وذكرى لاولي الالباب"
        },
        {
            "chapter": 38,
            "verse": 44,
            "text": "وخذ بيدك ضغثا فاضرب به ولا تحنث انا وجدناه صابرا نعم العبد انه اواب"
        },
        {
            "chapter": 38,
            "verse": 45,
            "text": "واذكر عبادنا ابراهيم واسحاق ويعقوب اولي الايدي والابصار"
        },
        {
            "chapter": 38,
            "verse": 46,
            "text": "انا اخلصناهم بخالصة ذكرى الدار"
        },
        {
            "chapter": 38,
            "verse": 47,
            "text": "وانهم عندنا لمن المصطفين الاخيار"
        },
        {
            "chapter": 38,
            "verse": 48,
            "text": "واذكر اسماعيل واليسع وذا الكفل وكل من الاخيار"
        },
        {
            "chapter": 38,
            "verse": 49,
            "text": "هذا ذكر وان للمتقين لحسن ماب"
        },
        {
            "chapter": 38,
            "verse": 50,
            "text": "جنات عدن مفتحة لهم الابواب"
        },
        {
            "chapter": 38,
            "verse": 51,
            "text": "متكيين فيها يدعون فيها بفاكهة كثيرة وشراب"
        },
        {
            "chapter": 38,
            "verse": 52,
            "text": "وعندهم قاصرات الطرف اتراب"
        },
        {
            "chapter": 38,
            "verse": 53,
            "text": "هذا ما توعدون ليوم الحساب"
        },
        {
            "chapter": 38,
            "verse": 54,
            "text": "ان هذا لرزقنا ما له من نفاد"
        },
        {
            "chapter": 38,
            "verse": 55,
            "text": "هذا وان للطاغين لشر ماب"
        },
        {
            "chapter": 38,
            "verse": 56,
            "text": "جهنم يصلونها فبيس المهاد"
        },
        {
            "chapter": 38,
            "verse": 57,
            "text": "هذا فليذوقوه حميم وغساق"
        },
        {
            "chapter": 38,
            "verse": 58,
            "text": "واخر من شكله ازواج"
        },
        {
            "chapter": 38,
            "verse": 59,
            "text": "هذا فوج مقتحم معكم لا مرحبا بهم انهم صالو النار"
        },
        {
            "chapter": 38,
            "verse": 60,
            "text": "قالوا بل انتم لا مرحبا بكم انتم قدمتموه لنا فبيس القرار"
        },
        {
            "chapter": 38,
            "verse": 61,
            "text": "قالوا ربنا من قدم لنا هذا فزده عذابا ضعفا في النار"
        },
        {
            "chapter": 38,
            "verse": 62,
            "text": "وقالوا ما لنا لا نرى رجالا كنا نعدهم من الاشرار"
        },
        {
            "chapter": 38,
            "verse": 63,
            "text": "اتخذناهم سخريا ام زاغت عنهم الابصار"
        },
        {
            "chapter": 38,
            "verse": 64,
            "text": "ان ذلك لحق تخاصم اهل النار"
        },
        {
            "chapter": 38,
            "verse": 65,
            "text": "قل انما انا منذر وما من اله الا الله الواحد القهار"
        },
        {
            "chapter": 38,
            "verse": 66,
            "text": "رب السماوات والارض وما بينهما العزيز الغفار"
        },
        {
            "chapter": 38,
            "verse": 67,
            "text": "قل هو نبا عظيم"
        },
        {
            "chapter": 38,
            "verse": 68,
            "text": "انتم عنه معرضون"
        },
        {
            "chapter": 38,
            "verse": 69,
            "text": "ما كان لي من علم بالملا الاعلى اذ يختصمون"
        },
        {
            "chapter": 38,
            "verse": 70,
            "text": "ان يوحى الي الا انما انا نذير مبين"
        },
        {
            "chapter": 38,
            "verse": 71,
            "text": "اذ قال ربك للملايكة اني خالق بشرا من طين"
        },
        {
            "chapter": 38,
            "verse": 72,
            "text": "فاذا سويته ونفخت فيه من روحي فقعوا له ساجدين"
        },
        {
            "chapter": 38,
            "verse": 73,
            "text": "فسجد الملايكة كلهم اجمعون"
        },
        {
            "chapter": 38,
            "verse": 74,
            "text": "الا ابليس استكبر وكان من الكافرين"
        },
        {
            "chapter": 38,
            "verse": 75,
            "text": "قال يا ابليس ما منعك ان تسجد لما خلقت بيدي استكبرت ام كنت من العالين"
        },
        {
            "chapter": 38,
            "verse": 76,
            "text": "قال انا خير منه خلقتني من نار وخلقته من طين"
        },
        {
            "chapter": 38,
            "verse": 77,
            "text": "قال فاخرج منها فانك رجيم"
        },
        {
            "chapter": 38,
            "verse": 78,
            "text": "وان عليك لعنتي الى يوم الدين"
        },
        {
            "chapter": 38,
            "verse": 79,
            "text": "قال رب فانظرني الى يوم يبعثون"
        },
        {
            "chapter": 38,
            "verse": 80,
            "text": "قال فانك من المنظرين"
        },
        {
            "chapter": 38,
            "verse": 81,
            "text": "الى يوم الوقت المعلوم"
        },
        {
            "chapter": 38,
            "verse": 82,
            "text": "قال فبعزتك لاغوينهم اجمعين"
        },
        {
            "chapter": 38,
            "verse": 83,
            "text": "الا عبادك منهم المخلصين"
        },
        {
            "chapter": 38,
            "verse": 84,
            "text": "قال فالحق والحق اقول"
        },
        {
            "chapter": 38,
            "verse": 85,
            "text": "لاملان جهنم منك وممن تبعك منهم اجمعين"
        },
        {
            "chapter": 38,
            "verse": 86,
            "text": "قل ما اسالكم عليه من اجر وما انا من المتكلفين"
        },
        {
            "chapter": 38,
            "verse": 87,
            "text": "ان هو الا ذكر للعالمين"
        },
        {
            "chapter": 38,
            "verse": 88,
            "text": "ولتعلمن نباه بعد حين"
        },
        {
            "chapter": 39,
            "verse": 1,
            "text": "تنزيل الكتاب من الله العزيز الحكيم"
        },
        {
            "chapter": 39,
            "verse": 2,
            "text": "انا انزلنا اليك الكتاب بالحق فاعبد الله مخلصا له الدين"
        },
        {
            "chapter": 39,
            "verse": 3,
            "text": "الا لله الدين الخالص والذين اتخذوا من دونه اولياء ما نعبدهم الا ليقربونا الى الله زلفى ان الله يحكم بينهم في ما هم فيه يختلفون ان الله لا يهدي من هو كاذب كفار"
        },
        {
            "chapter": 39,
            "verse": 4,
            "text": "لو اراد الله ان يتخذ ولدا لاصطفى مما يخلق ما يشاء سبحانه هو الله الواحد القهار"
        },
        {
            "chapter": 39,
            "verse": 5,
            "text": "خلق السماوات والارض بالحق يكور الليل على النهار ويكور النهار على الليل وسخر الشمس والقمر كل يجري لاجل مسمى الا هو العزيز الغفار"
        },
        {
            "chapter": 39,
            "verse": 6,
            "text": "خلقكم من نفس واحدة ثم جعل منها زوجها وانزل لكم من الانعام ثمانية ازواج يخلقكم في بطون امهاتكم خلقا من بعد خلق في ظلمات ثلاث ذلكم الله ربكم له الملك لا اله الا هو فانى تصرفون"
        },
        {
            "chapter": 39,
            "verse": 7,
            "text": "ان تكفروا فان الله غني عنكم ولا يرضى لعباده الكفر وان تشكروا يرضه لكم ولا تزر وازرة وزر اخرى ثم الى ربكم مرجعكم فينبيكم بما كنتم تعملون انه عليم بذات الصدور"
        },
        {
            "chapter": 39,
            "verse": 8,
            "text": "واذا مس الانسان ضر دعا ربه منيبا اليه ثم اذا خوله نعمة منه نسي ما كان يدعو اليه من قبل وجعل لله اندادا ليضل عن سبيله قل تمتع بكفرك قليلا انك من اصحاب النار"
        },
        {
            "chapter": 39,
            "verse": 9,
            "text": "امن هو قانت اناء الليل ساجدا وقايما يحذر الاخرة ويرجو رحمة ربه قل هل يستوي الذين يعلمون والذين لا يعلمون انما يتذكر اولو الالباب"
        },
        {
            "chapter": 39,
            "verse": 10,
            "text": "قل يا عباد الذين امنوا اتقوا ربكم للذين احسنوا في هذه الدنيا حسنة وارض الله واسعة انما يوفى الصابرون اجرهم بغير حساب"
        },
        {
            "chapter": 39,
            "verse": 11,
            "text": "قل اني امرت ان اعبد الله مخلصا له الدين"
        },
        {
            "chapter": 39,
            "verse": 12,
            "text": "وامرت لان اكون اول المسلمين"
        },
        {
            "chapter": 39,
            "verse": 13,
            "text": "قل اني اخاف ان عصيت ربي عذاب يوم عظيم"
        },
        {
            "chapter": 39,
            "verse": 14,
            "text": "قل الله اعبد مخلصا له ديني"
        },
        {
            "chapter": 39,
            "verse": 15,
            "text": "فاعبدوا ما شيتم من دونه قل ان الخاسرين الذين خسروا انفسهم واهليهم يوم القيامة الا ذلك هو الخسران المبين"
        },
        {
            "chapter": 39,
            "verse": 16,
            "text": "لهم من فوقهم ظلل من النار ومن تحتهم ظلل ذلك يخوف الله به عباده يا عباد فاتقون"
        },
        {
            "chapter": 39,
            "verse": 17,
            "text": "والذين اجتنبوا الطاغوت ان يعبدوها وانابوا الى الله لهم البشرى فبشر عباد"
        },
        {
            "chapter": 39,
            "verse": 18,
            "text": "الذين يستمعون القول فيتبعون احسنه اوليك الذين هداهم الله واوليك هم اولو الالباب"
        },
        {
            "chapter": 39,
            "verse": 19,
            "text": "افمن حق عليه كلمة العذاب افانت تنقذ من في النار"
        },
        {
            "chapter": 39,
            "verse": 20,
            "text": "لكن الذين اتقوا ربهم لهم غرف من فوقها غرف مبنية تجري من تحتها الانهار وعد الله لا يخلف الله الميعاد"
        },
        {
            "chapter": 39,
            "verse": 21,
            "text": "الم تر ان الله انزل من السماء ماء فسلكه ينابيع في الارض ثم يخرج به زرعا مختلفا الوانه ثم يهيج فتراه مصفرا ثم يجعله حطاما ان في ذلك لذكرى لاولي الالباب"
        },
        {
            "chapter": 39,
            "verse": 22,
            "text": "افمن شرح الله صدره للاسلام فهو على نور من ربه فويل للقاسية قلوبهم من ذكر الله اوليك في ضلال مبين"
        },
        {
            "chapter": 39,
            "verse": 23,
            "text": "الله نزل احسن الحديث كتابا متشابها مثاني تقشعر منه جلود الذين يخشون ربهم ثم تلين جلودهم وقلوبهم الى ذكر الله ذلك هدى الله يهدي به من يشاء ومن يضلل الله فما له من هاد"
        },
        {
            "chapter": 39,
            "verse": 24,
            "text": "افمن يتقي بوجهه سوء العذاب يوم القيامة وقيل للظالمين ذوقوا ما كنتم تكسبون"
        },
        {
            "chapter": 39,
            "verse": 25,
            "text": "كذب الذين من قبلهم فاتاهم العذاب من حيث لا يشعرون"
        },
        {
            "chapter": 39,
            "verse": 26,
            "text": "فاذاقهم الله الخزي في الحياة الدنيا ولعذاب الاخرة اكبر لو كانوا يعلمون"
        },
        {
            "chapter": 39,
            "verse": 27,
            "text": "ولقد ضربنا للناس في هذا القران من كل مثل لعلهم يتذكرون"
        },
        {
            "chapter": 39,
            "verse": 28,
            "text": "قرانا عربيا غير ذي عوج لعلهم يتقون"
        },
        {
            "chapter": 39,
            "verse": 29,
            "text": "ضرب الله مثلا رجلا فيه شركاء متشاكسون ورجلا سلما لرجل هل يستويان مثلا الحمد لله بل اكثرهم لا يعلمون"
        },
        {
            "chapter": 39,
            "verse": 30,
            "text": "انك ميت وانهم ميتون"
        },
        {
            "chapter": 39,
            "verse": 31,
            "text": "ثم انكم يوم القيامة عند ربكم تختصمون"
        }
    ]
}