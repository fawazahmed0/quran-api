{
    "pages": [
        {
            "chapter": 37,
            "verse": 52,
            "text": "يقول اانك لمن المصدقين"
        },
        {
            "chapter": 37,
            "verse": 53,
            "text": "ااذا متنا وكنا ترابا وعظاما اانا لمدينون"
        },
        {
            "chapter": 37,
            "verse": 54,
            "text": "قال هل انتم مطلعون"
        },
        {
            "chapter": 37,
            "verse": 55,
            "text": "فاطلع فراه في سواء الجحيم"
        },
        {
            "chapter": 37,
            "verse": 56,
            "text": "قال تالله ان كدت لتردين"
        },
        {
            "chapter": 37,
            "verse": 57,
            "text": "ولولا نعمة ربي لكنت من المحضرين"
        },
        {
            "chapter": 37,
            "verse": 58,
            "text": "افما نحن بميتين"
        },
        {
            "chapter": 37,
            "verse": 59,
            "text": "الا موتتنا الاولى وما نحن بمعذبين"
        },
        {
            "chapter": 37,
            "verse": 60,
            "text": "ان هذا لهو الفوز العظيم"
        },
        {
            "chapter": 37,
            "verse": 61,
            "text": "لمثل هذا فليعمل العاملون"
        },
        {
            "chapter": 37,
            "verse": 62,
            "text": "اذلك خير نزلا ام شجرة الزقوم"
        },
        {
            "chapter": 37,
            "verse": 63,
            "text": "انا جعلناها فتنة للظالمين"
        },
        {
            "chapter": 37,
            "verse": 64,
            "text": "انها شجرة تخرج في اصل الجحيم"
        },
        {
            "chapter": 37,
            "verse": 65,
            "text": "طلعها كانه رءوس الشياطين"
        },
        {
            "chapter": 37,
            "verse": 66,
            "text": "فانهم لاكلون منها فماليون منها البطون"
        },
        {
            "chapter": 37,
            "verse": 67,
            "text": "ثم ان لهم عليها لشوبا من حميم"
        },
        {
            "chapter": 37,
            "verse": 68,
            "text": "ثم ان مرجعهم لالى الجحيم"
        },
        {
            "chapter": 37,
            "verse": 69,
            "text": "انهم الفوا اباءهم ضالين"
        },
        {
            "chapter": 37,
            "verse": 70,
            "text": "فهم على اثارهم يهرعون"
        },
        {
            "chapter": 37,
            "verse": 71,
            "text": "ولقد ضل قبلهم اكثر الاولين"
        },
        {
            "chapter": 37,
            "verse": 72,
            "text": "ولقد ارسلنا فيهم منذرين"
        },
        {
            "chapter": 37,
            "verse": 73,
            "text": "فانظر كيف كان عاقبة المنذرين"
        },
        {
            "chapter": 37,
            "verse": 74,
            "text": "الا عباد الله المخلصين"
        },
        {
            "chapter": 37,
            "verse": 75,
            "text": "ولقد نادانا نوح فلنعم المجيبون"
        },
        {
            "chapter": 37,
            "verse": 76,
            "text": "ونجيناه واهله من الكرب العظيم"
        }
    ]
}