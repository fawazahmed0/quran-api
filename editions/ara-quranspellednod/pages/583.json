{
    "pages": [
        {
            "chapter": 78,
            "verse": 31,
            "text": "ان للمتقين مفازا"
        },
        {
            "chapter": 78,
            "verse": 32,
            "text": "حدايق واعنابا"
        },
        {
            "chapter": 78,
            "verse": 33,
            "text": "وكواعب اترابا"
        },
        {
            "chapter": 78,
            "verse": 34,
            "text": "وكاسا دهاقا"
        },
        {
            "chapter": 78,
            "verse": 35,
            "text": "لا يسمعون فيها لغوا ولا كذابا"
        },
        {
            "chapter": 78,
            "verse": 36,
            "text": "جزاء من ربك عطاء حسابا"
        },
        {
            "chapter": 78,
            "verse": 37,
            "text": "رب السماوات والارض وما بينهما الرحمن لا يملكون منه خطابا"
        },
        {
            "chapter": 78,
            "verse": 38,
            "text": "يوم يقوم الروح والملايكة صفا لا يتكلمون الا من اذن له الرحمن وقال صوابا"
        },
        {
            "chapter": 78,
            "verse": 39,
            "text": "ذلك اليوم الحق فمن شاء اتخذ الى ربه مابا"
        },
        {
            "chapter": 78,
            "verse": 40,
            "text": "انا انذرناكم عذابا قريبا يوم ينظر المرء ما قدمت يداه ويقول الكافر يا ليتني كنت ترابا"
        },
        {
            "chapter": 79,
            "verse": 1,
            "text": "والنازعات غرقا"
        },
        {
            "chapter": 79,
            "verse": 2,
            "text": "والناشطات نشطا"
        },
        {
            "chapter": 79,
            "verse": 3,
            "text": "والسابحات سبحا"
        },
        {
            "chapter": 79,
            "verse": 4,
            "text": "فالسابقات سبقا"
        },
        {
            "chapter": 79,
            "verse": 5,
            "text": "فالمدبرات امرا"
        },
        {
            "chapter": 79,
            "verse": 6,
            "text": "يوم ترجف الراجفة"
        },
        {
            "chapter": 79,
            "verse": 7,
            "text": "تتبعها الرادفة"
        },
        {
            "chapter": 79,
            "verse": 8,
            "text": "قلوب يوميذ واجفة"
        },
        {
            "chapter": 79,
            "verse": 9,
            "text": "ابصارها خاشعة"
        },
        {
            "chapter": 79,
            "verse": 10,
            "text": "يقولون اانا لمردودون في الحافرة"
        },
        {
            "chapter": 79,
            "verse": 11,
            "text": "ااذا كنا عظاما نخرة"
        },
        {
            "chapter": 79,
            "verse": 12,
            "text": "قالوا تلك اذا كرة خاسرة"
        },
        {
            "chapter": 79,
            "verse": 13,
            "text": "فانما هي زجرة واحدة"
        },
        {
            "chapter": 79,
            "verse": 14,
            "text": "فاذا هم بالساهرة"
        },
        {
            "chapter": 79,
            "verse": 15,
            "text": "هل اتاك حديث موسى"
        }
    ]
}