{"pages":[{"chapter":26,"verse":207,"text":"ما اغنى عنهم ما كانوا يمتعون"},{"chapter":26,"verse":208,"text":"وما اهلكنا من قرية الا لها منذرون"},{"chapter":26,"verse":209,"text":"ذكرى وما كنا ظالمين"},{"chapter":26,"verse":210,"text":"وما تنزلت به الشياطين"},{"chapter":26,"verse":211,"text":"وما ينبغي لهم وما يستطيعون"},{"chapter":26,"verse":212,"text":"انهم عن السمع لمعزولون"},{"chapter":26,"verse":213,"text":"فلا تدع مع الله الها اخر فتكون من المعذبين"},{"chapter":26,"verse":214,"text":"وانذر عشيرتك الاقربين"},{"chapter":26,"verse":215,"text":"واخفض جناحك لمن اتبعك من المومنين"},{"chapter":26,"verse":216,"text":"فان عصوك فقل اني بريء مما تعملون"},{"chapter":26,"verse":217,"text":"وتوكل على العزيز الرحيم"},{"chapter":26,"verse":218,"text":"الذي يراك حين تقوم"},{"chapter":26,"verse":219,"text":"وتقلبك في الساجدين"},{"chapter":26,"verse":220,"text":"انه هو السميع العليم"},{"chapter":26,"verse":221,"text":"هل انبيكم على من تنزل الشياطين"},{"chapter":26,"verse":222,"text":"تنزل على كل افاك اثيم"},{"chapter":26,"verse":223,"text":"يلقون السمع واكثرهم كاذبون"},{"chapter":26,"verse":224,"text":"والشعراء يتبعهم الغاوون"},{"chapter":26,"verse":225,"text":"الم تر انهم في كل واد يهيمون"},{"chapter":26,"verse":226,"text":"وانهم يقولون ما لا يفعلون"},{"chapter":26,"verse":227,"text":"الا الذين امنوا وعملوا الصالحات وذكروا الله كثيرا وانتصروا من بعد ما ظلموا وسيعلم الذين ظلموا اي منقلب ينقلبون"}]}