{
    "pages": [
        {
            "chapter": 37,
            "verse": 1,
            "text": "والصافات صفا"
        },
        {
            "chapter": 37,
            "verse": 2,
            "text": "فالزاجرات زجرا"
        },
        {
            "chapter": 37,
            "verse": 3,
            "text": "فالتاليات ذكرا"
        },
        {
            "chapter": 37,
            "verse": 4,
            "text": "ان الهكم لواحد"
        },
        {
            "chapter": 37,
            "verse": 5,
            "text": "رب السماوات والارض وما بينهما ورب المشارق"
        },
        {
            "chapter": 37,
            "verse": 6,
            "text": "انا زينا السماء الدنيا بزينة الكواكب"
        },
        {
            "chapter": 37,
            "verse": 7,
            "text": "وحفظا من كل شيطان مارد"
        },
        {
            "chapter": 37,
            "verse": 8,
            "text": "لا يسمعون الى الملا الاعلى ويقذفون من كل جانب"
        },
        {
            "chapter": 37,
            "verse": 9,
            "text": "دحورا ولهم عذاب واصب"
        },
        {
            "chapter": 37,
            "verse": 10,
            "text": "الا من خطف الخطفة فاتبعه شهاب ثاقب"
        },
        {
            "chapter": 37,
            "verse": 11,
            "text": "فاستفتهم اهم اشد خلقا ام من خلقنا انا خلقناهم من طين لازب"
        },
        {
            "chapter": 37,
            "verse": 12,
            "text": "بل عجبت ويسخرون"
        },
        {
            "chapter": 37,
            "verse": 13,
            "text": "واذا ذكروا لا يذكرون"
        },
        {
            "chapter": 37,
            "verse": 14,
            "text": "واذا راوا اية يستسخرون"
        },
        {
            "chapter": 37,
            "verse": 15,
            "text": "وقالوا ان هذا الا سحر مبين"
        },
        {
            "chapter": 37,
            "verse": 16,
            "text": "ااذا متنا وكنا ترابا وعظاما اانا لمبعوثون"
        },
        {
            "chapter": 37,
            "verse": 17,
            "text": "اواباونا الاولون"
        },
        {
            "chapter": 37,
            "verse": 18,
            "text": "قل نعم وانتم داخرون"
        },
        {
            "chapter": 37,
            "verse": 19,
            "text": "فانما هي زجرة واحدة فاذا هم ينظرون"
        },
        {
            "chapter": 37,
            "verse": 20,
            "text": "وقالوا يا ويلنا هذا يوم الدين"
        },
        {
            "chapter": 37,
            "verse": 21,
            "text": "هذا يوم الفصل الذي كنتم به تكذبون"
        },
        {
            "chapter": 37,
            "verse": 22,
            "text": "احشروا الذين ظلموا وازواجهم وما كانوا يعبدون"
        },
        {
            "chapter": 37,
            "verse": 23,
            "text": "من دون الله فاهدوهم الى صراط الجحيم"
        },
        {
            "chapter": 37,
            "verse": 24,
            "text": "وقفوهم انهم مسيولون"
        }
    ]
}