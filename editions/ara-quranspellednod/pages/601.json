{
    "pages": [
        {
            "chapter": 103,
            "verse": 1,
            "text": "والعصر"
        },
        {
            "chapter": 103,
            "verse": 2,
            "text": "ان الانسان لفي خسر"
        },
        {
            "chapter": 103,
            "verse": 3,
            "text": "الا الذين امنوا وعملوا الصالحات وتواصوا بالحق وتواصوا بالصبر"
        },
        {
            "chapter": 104,
            "verse": 1,
            "text": "ويل لكل همزة لمزة"
        },
        {
            "chapter": 104,
            "verse": 2,
            "text": "الذي جمع مالا وعدده"
        },
        {
            "chapter": 104,
            "verse": 3,
            "text": "يحسب ان ماله اخلده"
        },
        {
            "chapter": 104,
            "verse": 4,
            "text": "كلا لينبذن في الحطمة"
        },
        {
            "chapter": 104,
            "verse": 5,
            "text": "وما ادراك ما الحطمة"
        },
        {
            "chapter": 104,
            "verse": 6,
            "text": "نار الله الموقدة"
        },
        {
            "chapter": 104,
            "verse": 7,
            "text": "التي تطلع على الافيدة"
        },
        {
            "chapter": 104,
            "verse": 8,
            "text": "انها عليهم موصدة"
        },
        {
            "chapter": 104,
            "verse": 9,
            "text": "في عمد ممددة"
        },
        {
            "chapter": 105,
            "verse": 1,
            "text": "الم تر كيف فعل ربك باصحاب الفيل"
        },
        {
            "chapter": 105,
            "verse": 2,
            "text": "الم يجعل كيدهم في تضليل"
        },
        {
            "chapter": 105,
            "verse": 3,
            "text": "وارسل عليهم طيرا ابابيل"
        },
        {
            "chapter": 105,
            "verse": 4,
            "text": "ترميهم بحجارة من سجيل"
        },
        {
            "chapter": 105,
            "verse": 5,
            "text": "فجعلهم كعصف ماكول"
        }
    ]
}