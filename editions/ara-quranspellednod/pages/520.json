{
    "pages": [
        {
            "chapter": 50,
            "verse": 36,
            "text": "وكم اهلكنا قبلهم من قرن هم اشد منهم بطشا فنقبوا في البلاد هل من محيص"
        },
        {
            "chapter": 50,
            "verse": 37,
            "text": "ان في ذلك لذكرى لمن كان له قلب او القى السمع وهو شهيد"
        },
        {
            "chapter": 50,
            "verse": 38,
            "text": "ولقد خلقنا السماوات والارض وما بينهما في ستة ايام وما مسنا من لغوب"
        },
        {
            "chapter": 50,
            "verse": 39,
            "text": "فاصبر على ما يقولون وسبح بحمد ربك قبل طلوع الشمس وقبل الغروب"
        },
        {
            "chapter": 50,
            "verse": 40,
            "text": "ومن الليل فسبحه وادبار السجود"
        },
        {
            "chapter": 50,
            "verse": 41,
            "text": "واستمع يوم يناد المناد من مكان قريب"
        },
        {
            "chapter": 50,
            "verse": 42,
            "text": "يوم يسمعون الصيحة بالحق ذلك يوم الخروج"
        },
        {
            "chapter": 50,
            "verse": 43,
            "text": "انا نحن نحيي ونميت والينا المصير"
        },
        {
            "chapter": 50,
            "verse": 44,
            "text": "يوم تشقق الارض عنهم سراعا ذلك حشر علينا يسير"
        },
        {
            "chapter": 50,
            "verse": 45,
            "text": "نحن اعلم بما يقولون وما انت عليهم بجبار فذكر بالقران من يخاف وعيد"
        },
        {
            "chapter": 51,
            "verse": 1,
            "text": "والذاريات ذروا"
        },
        {
            "chapter": 51,
            "verse": 2,
            "text": "فالحاملات وقرا"
        },
        {
            "chapter": 51,
            "verse": 3,
            "text": "فالجاريات يسرا"
        },
        {
            "chapter": 51,
            "verse": 4,
            "text": "فالمقسمات امرا"
        },
        {
            "chapter": 51,
            "verse": 5,
            "text": "انما توعدون لصادق"
        },
        {
            "chapter": 51,
            "verse": 6,
            "text": "وان الدين لواقع"
        }
    ]
}