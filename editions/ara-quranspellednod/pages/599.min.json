{"pages":[{"chapter":98,"verse":8,"text":"جزاوهم عند ربهم جنات عدن تجري من تحتها الانهار خالدين فيها ابدا رضي الله عنهم ورضوا عنه ذلك لمن خشي ربه"},{"chapter":99,"verse":1,"text":"اذا زلزلت الارض زلزالها"},{"chapter":99,"verse":2,"text":"واخرجت الارض اثقالها"},{"chapter":99,"verse":3,"text":"وقال الانسان ما لها"},{"chapter":99,"verse":4,"text":"يوميذ تحدث اخبارها"},{"chapter":99,"verse":5,"text":"بان ربك اوحى لها"},{"chapter":99,"verse":6,"text":"يوميذ يصدر الناس اشتاتا ليروا اعمالهم"},{"chapter":99,"verse":7,"text":"فمن يعمل مثقال ذرة خيرا يره"},{"chapter":99,"verse":8,"text":"ومن يعمل مثقال ذرة شرا يره"},{"chapter":100,"verse":1,"text":"والعاديات ضبحا"},{"chapter":100,"verse":2,"text":"فالموريات قدحا"},{"chapter":100,"verse":3,"text":"فالمغيرات صبحا"},{"chapter":100,"verse":4,"text":"فاثرن به نقعا"},{"chapter":100,"verse":5,"text":"فوسطن به جمعا"},{"chapter":100,"verse":6,"text":"ان الانسان لربه لكنود"},{"chapter":100,"verse":7,"text":"وانه على ذلك لشهيد"},{"chapter":100,"verse":8,"text":"وانه لحب الخير لشديد"},{"chapter":100,"verse":9,"text":"افلا يعلم اذا بعثر ما في القبور"}]}