{
    "pages": [
        {
            "chapter": 19,
            "verse": 77,
            "text": "افرايت الذي كفر باياتنا وقال لاوتين مالا وولدا"
        },
        {
            "chapter": 19,
            "verse": 78,
            "text": "اطلع الغيب ام اتخذ عند الرحمن عهدا"
        },
        {
            "chapter": 19,
            "verse": 79,
            "text": "كلا سنكتب ما يقول ونمد له من العذاب مدا"
        },
        {
            "chapter": 19,
            "verse": 80,
            "text": "ونرثه ما يقول وياتينا فردا"
        },
        {
            "chapter": 19,
            "verse": 81,
            "text": "واتخذوا من دون الله الهة ليكونوا لهم عزا"
        },
        {
            "chapter": 19,
            "verse": 82,
            "text": "كلا سيكفرون بعبادتهم ويكونون عليهم ضدا"
        },
        {
            "chapter": 19,
            "verse": 83,
            "text": "الم تر انا ارسلنا الشياطين على الكافرين توزهم ازا"
        },
        {
            "chapter": 19,
            "verse": 84,
            "text": "فلا تعجل عليهم انما نعد لهم عدا"
        },
        {
            "chapter": 19,
            "verse": 85,
            "text": "يوم نحشر المتقين الى الرحمن وفدا"
        },
        {
            "chapter": 19,
            "verse": 86,
            "text": "ونسوق المجرمين الى جهنم وردا"
        },
        {
            "chapter": 19,
            "verse": 87,
            "text": "لا يملكون الشفاعة الا من اتخذ عند الرحمن عهدا"
        },
        {
            "chapter": 19,
            "verse": 88,
            "text": "وقالوا اتخذ الرحمن ولدا"
        },
        {
            "chapter": 19,
            "verse": 89,
            "text": "لقد جيتم شييا ادا"
        },
        {
            "chapter": 19,
            "verse": 90,
            "text": "تكاد السماوات يتفطرن منه وتنشق الارض وتخر الجبال هدا"
        },
        {
            "chapter": 19,
            "verse": 91,
            "text": "ان دعوا للرحمن ولدا"
        },
        {
            "chapter": 19,
            "verse": 92,
            "text": "وما ينبغي للرحمن ان يتخذ ولدا"
        },
        {
            "chapter": 19,
            "verse": 93,
            "text": "ان كل من في السماوات والارض الا اتي الرحمن عبدا"
        },
        {
            "chapter": 19,
            "verse": 94,
            "text": "لقد احصاهم وعدهم عدا"
        },
        {
            "chapter": 19,
            "verse": 95,
            "text": "وكلهم اتيه يوم القيامة فردا"
        }
    ]
}