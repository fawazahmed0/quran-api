{
    "pages": [
        {
            "chapter": 36,
            "verse": 55,
            "text": "ان اصحاب الجنة اليوم في شغل فاكهون"
        },
        {
            "chapter": 36,
            "verse": 56,
            "text": "هم وازواجهم في ظلال على الارايك متكيون"
        },
        {
            "chapter": 36,
            "verse": 57,
            "text": "لهم فيها فاكهة ولهم ما يدعون"
        },
        {
            "chapter": 36,
            "verse": 58,
            "text": "سلام قولا من رب رحيم"
        },
        {
            "chapter": 36,
            "verse": 59,
            "text": "وامتازوا اليوم ايها المجرمون"
        },
        {
            "chapter": 36,
            "verse": 60,
            "text": "الم اعهد اليكم يا بني ادم ان لا تعبدوا الشيطان انه لكم عدو مبين"
        },
        {
            "chapter": 36,
            "verse": 61,
            "text": "وان اعبدوني هذا صراط مستقيم"
        },
        {
            "chapter": 36,
            "verse": 62,
            "text": "ولقد اضل منكم جبلا كثيرا افلم تكونوا تعقلون"
        },
        {
            "chapter": 36,
            "verse": 63,
            "text": "هذه جهنم التي كنتم توعدون"
        },
        {
            "chapter": 36,
            "verse": 64,
            "text": "اصلوها اليوم بما كنتم تكفرون"
        },
        {
            "chapter": 36,
            "verse": 65,
            "text": "اليوم نختم على افواههم وتكلمنا ايديهم وتشهد ارجلهم بما كانوا يكسبون"
        },
        {
            "chapter": 36,
            "verse": 66,
            "text": "ولو نشاء لطمسنا على اعينهم فاستبقوا الصراط فانى يبصرون"
        },
        {
            "chapter": 36,
            "verse": 67,
            "text": "ولو نشاء لمسخناهم على مكانتهم فما استطاعوا مضيا ولا يرجعون"
        },
        {
            "chapter": 36,
            "verse": 68,
            "text": "ومن نعمره ننكسه في الخلق افلا يعقلون"
        },
        {
            "chapter": 36,
            "verse": 69,
            "text": "وما علمناه الشعر وما ينبغي له ان هو الا ذكر وقران مبين"
        },
        {
            "chapter": 36,
            "verse": 70,
            "text": "لينذر من كان حيا ويحق القول على الكافرين"
        }
    ]
}