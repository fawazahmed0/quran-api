{
    "pages": [
        {
            "chapter": 15,
            "verse": 91,
            "text": "الذين جعلوا القران عضين"
        },
        {
            "chapter": 15,
            "verse": 92,
            "text": "فوربك لنسالنهم اجمعين"
        },
        {
            "chapter": 15,
            "verse": 93,
            "text": "عما كانوا يعملون"
        },
        {
            "chapter": 15,
            "verse": 94,
            "text": "فاصدع بما تومر واعرض عن المشركين"
        },
        {
            "chapter": 15,
            "verse": 95,
            "text": "انا كفيناك المستهزيين"
        },
        {
            "chapter": 15,
            "verse": 96,
            "text": "الذين يجعلون مع الله الها اخر فسوف يعلمون"
        },
        {
            "chapter": 15,
            "verse": 97,
            "text": "ولقد نعلم انك يضيق صدرك بما يقولون"
        },
        {
            "chapter": 15,
            "verse": 98,
            "text": "فسبح بحمد ربك وكن من الساجدين"
        },
        {
            "chapter": 15,
            "verse": 99,
            "text": "واعبد ربك حتى ياتيك اليقين"
        },
        {
            "chapter": 16,
            "verse": 1,
            "text": "اتى امر الله فلا تستعجلوه سبحانه وتعالى عما يشركون"
        },
        {
            "chapter": 16,
            "verse": 2,
            "text": "ينزل الملايكة بالروح من امره على من يشاء من عباده ان انذروا انه لا اله الا انا فاتقون"
        },
        {
            "chapter": 16,
            "verse": 3,
            "text": "خلق السماوات والارض بالحق تعالى عما يشركون"
        },
        {
            "chapter": 16,
            "verse": 4,
            "text": "خلق الانسان من نطفة فاذا هو خصيم مبين"
        },
        {
            "chapter": 16,
            "verse": 5,
            "text": "والانعام خلقها لكم فيها دفء ومنافع ومنها تاكلون"
        },
        {
            "chapter": 16,
            "verse": 6,
            "text": "ولكم فيها جمال حين تريحون وحين تسرحون"
        }
    ]
}