{
    "pages": [
        {
            "chapter": 95,
            "verse": 1,
            "text": "والتين والزيتون"
        },
        {
            "chapter": 95,
            "verse": 2,
            "text": "وطور سينين"
        },
        {
            "chapter": 95,
            "verse": 3,
            "text": "وهذا البلد الامين"
        },
        {
            "chapter": 95,
            "verse": 4,
            "text": "لقد خلقنا الانسان في احسن تقويم"
        },
        {
            "chapter": 95,
            "verse": 5,
            "text": "ثم رددناه اسفل سافلين"
        },
        {
            "chapter": 95,
            "verse": 6,
            "text": "الا الذين امنوا وعملوا الصالحات فلهم اجر غير ممنون"
        },
        {
            "chapter": 95,
            "verse": 7,
            "text": "فما يكذبك بعد بالدين"
        },
        {
            "chapter": 95,
            "verse": 8,
            "text": "اليس الله باحكم الحاكمين"
        },
        {
            "chapter": 96,
            "verse": 1,
            "text": "اقرا باسم ربك الذي خلق"
        },
        {
            "chapter": 96,
            "verse": 2,
            "text": "خلق الانسان من علق"
        },
        {
            "chapter": 96,
            "verse": 3,
            "text": "اقرا وربك الاكرم"
        },
        {
            "chapter": 96,
            "verse": 4,
            "text": "الذي علم بالقلم"
        },
        {
            "chapter": 96,
            "verse": 5,
            "text": "علم الانسان ما لم يعلم"
        },
        {
            "chapter": 96,
            "verse": 6,
            "text": "كلا ان الانسان ليطغى"
        },
        {
            "chapter": 96,
            "verse": 7,
            "text": "ان راه استغنى"
        },
        {
            "chapter": 96,
            "verse": 8,
            "text": "ان الى ربك الرجعى"
        },
        {
            "chapter": 96,
            "verse": 9,
            "text": "ارايت الذي ينهى"
        },
        {
            "chapter": 96,
            "verse": 10,
            "text": "عبدا اذا صلى"
        },
        {
            "chapter": 96,
            "verse": 11,
            "text": "ارايت ان كان على الهدى"
        },
        {
            "chapter": 96,
            "verse": 12,
            "text": "او امر بالتقوى"
        },
        {
            "chapter": 96,
            "verse": 13,
            "text": "ارايت ان كذب وتولى"
        },
        {
            "chapter": 96,
            "verse": 14,
            "text": "الم يعلم بان الله يرى"
        },
        {
            "chapter": 96,
            "verse": 15,
            "text": "كلا لين لم ينته لنسفعا بالناصية"
        },
        {
            "chapter": 96,
            "verse": 16,
            "text": "ناصية كاذبة خاطية"
        },
        {
            "chapter": 96,
            "verse": 17,
            "text": "فليدع ناديه"
        },
        {
            "chapter": 96,
            "verse": 18,
            "text": "سندع الزبانية"
        },
        {
            "chapter": 96,
            "verse": 19,
            "text": "كلا لا تطعه واسجد واقترب"
        }
    ]
}