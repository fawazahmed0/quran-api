{
    "pages": [
        {
            "chapter": 54,
            "verse": 7,
            "text": "خشعا ابصارهم يخرجون من الاجداث كانهم جراد منتشر"
        },
        {
            "chapter": 54,
            "verse": 8,
            "text": "مهطعين الى الداع يقول الكافرون هذا يوم عسر"
        },
        {
            "chapter": 54,
            "verse": 9,
            "text": "كذبت قبلهم قوم نوح فكذبوا عبدنا وقالوا مجنون وازدجر"
        },
        {
            "chapter": 54,
            "verse": 10,
            "text": "فدعا ربه اني مغلوب فانتصر"
        },
        {
            "chapter": 54,
            "verse": 11,
            "text": "ففتحنا ابواب السماء بماء منهمر"
        },
        {
            "chapter": 54,
            "verse": 12,
            "text": "وفجرنا الارض عيونا فالتقى الماء على امر قد قدر"
        },
        {
            "chapter": 54,
            "verse": 13,
            "text": "وحملناه على ذات الواح ودسر"
        },
        {
            "chapter": 54,
            "verse": 14,
            "text": "تجري باعيننا جزاء لمن كان كفر"
        },
        {
            "chapter": 54,
            "verse": 15,
            "text": "ولقد تركناها اية فهل من مدكر"
        },
        {
            "chapter": 54,
            "verse": 16,
            "text": "فكيف كان عذابي ونذر"
        },
        {
            "chapter": 54,
            "verse": 17,
            "text": "ولقد يسرنا القران للذكر فهل من مدكر"
        },
        {
            "chapter": 54,
            "verse": 18,
            "text": "كذبت عاد فكيف كان عذابي ونذر"
        },
        {
            "chapter": 54,
            "verse": 19,
            "text": "انا ارسلنا عليهم ريحا صرصرا في يوم نحس مستمر"
        },
        {
            "chapter": 54,
            "verse": 20,
            "text": "تنزع الناس كانهم اعجاز نخل منقعر"
        },
        {
            "chapter": 54,
            "verse": 21,
            "text": "فكيف كان عذابي ونذر"
        },
        {
            "chapter": 54,
            "verse": 22,
            "text": "ولقد يسرنا القران للذكر فهل من مدكر"
        },
        {
            "chapter": 54,
            "verse": 23,
            "text": "كذبت ثمود بالنذر"
        },
        {
            "chapter": 54,
            "verse": 24,
            "text": "فقالوا ابشرا منا واحدا نتبعه انا اذا لفي ضلال وسعر"
        },
        {
            "chapter": 54,
            "verse": 25,
            "text": "االقي الذكر عليه من بيننا بل هو كذاب اشر"
        },
        {
            "chapter": 54,
            "verse": 26,
            "text": "سيعلمون غدا من الكذاب الاشر"
        },
        {
            "chapter": 54,
            "verse": 27,
            "text": "انا مرسلو الناقة فتنة لهم فارتقبهم واصطبر"
        }
    ]
}