{"pages":[{"chapter":76,"verse":26,"text":"ومن الليل فاسجد له وسبحه ليلا طويلا"},{"chapter":76,"verse":27,"text":"ان هولاء يحبون العاجلة ويذرون وراءهم يوما ثقيلا"},{"chapter":76,"verse":28,"text":"نحن خلقناهم وشددنا اسرهم واذا شينا بدلنا امثالهم تبديلا"},{"chapter":76,"verse":29,"text":"ان هذه تذكرة فمن شاء اتخذ الى ربه سبيلا"},{"chapter":76,"verse":30,"text":"وما تشاءون الا ان يشاء الله ان الله كان عليما حكيما"},{"chapter":76,"verse":31,"text":"يدخل من يشاء في رحمته والظالمين اعد لهم عذابا اليما"},{"chapter":77,"verse":1,"text":"والمرسلات عرفا"},{"chapter":77,"verse":2,"text":"فالعاصفات عصفا"},{"chapter":77,"verse":3,"text":"والناشرات نشرا"},{"chapter":77,"verse":4,"text":"فالفارقات فرقا"},{"chapter":77,"verse":5,"text":"فالملقيات ذكرا"},{"chapter":77,"verse":6,"text":"عذرا او نذرا"},{"chapter":77,"verse":7,"text":"انما توعدون لواقع"},{"chapter":77,"verse":8,"text":"فاذا النجوم طمست"},{"chapter":77,"verse":9,"text":"واذا السماء فرجت"},{"chapter":77,"verse":10,"text":"واذا الجبال نسفت"},{"chapter":77,"verse":11,"text":"واذا الرسل اقتت"},{"chapter":77,"verse":12,"text":"لاي يوم اجلت"},{"chapter":77,"verse":13,"text":"ليوم الفصل"},{"chapter":77,"verse":14,"text":"وما ادراك ما يوم الفصل"},{"chapter":77,"verse":15,"text":"ويل يوميذ للمكذبين"},{"chapter":77,"verse":16,"text":"الم نهلك الاولين"},{"chapter":77,"verse":17,"text":"ثم نتبعهم الاخرين"},{"chapter":77,"verse":18,"text":"كذلك نفعل بالمجرمين"},{"chapter":77,"verse":19,"text":"ويل يوميذ للمكذبين"}]}