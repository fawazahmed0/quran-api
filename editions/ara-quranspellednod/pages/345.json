{
    "pages": [
        {
            "chapter": 23,
            "verse": 43,
            "text": "ما تسبق من امة اجلها وما يستاخرون"
        },
        {
            "chapter": 23,
            "verse": 44,
            "text": "ثم ارسلنا رسلنا تترى كل ما جاء امة رسولها كذبوه فاتبعنا بعضهم بعضا وجعلناهم احاديث فبعدا لقوم لا يومنون"
        },
        {
            "chapter": 23,
            "verse": 45,
            "text": "ثم ارسلنا موسى واخاه هارون باياتنا وسلطان مبين"
        },
        {
            "chapter": 23,
            "verse": 46,
            "text": "الى فرعون ومليه فاستكبروا وكانوا قوما عالين"
        },
        {
            "chapter": 23,
            "verse": 47,
            "text": "فقالوا انومن لبشرين مثلنا وقومهما لنا عابدون"
        },
        {
            "chapter": 23,
            "verse": 48,
            "text": "فكذبوهما فكانوا من المهلكين"
        },
        {
            "chapter": 23,
            "verse": 49,
            "text": "ولقد اتينا موسى الكتاب لعلهم يهتدون"
        },
        {
            "chapter": 23,
            "verse": 50,
            "text": "وجعلنا ابن مريم وامه اية واويناهما الى ربوة ذات قرار ومعين"
        },
        {
            "chapter": 23,
            "verse": 51,
            "text": "يا ايها الرسل كلوا من الطيبات واعملوا صالحا اني بما تعملون عليم"
        },
        {
            "chapter": 23,
            "verse": 52,
            "text": "وان هذه امتكم امة واحدة وانا ربكم فاتقون"
        },
        {
            "chapter": 23,
            "verse": 53,
            "text": "فتقطعوا امرهم بينهم زبرا كل حزب بما لديهم فرحون"
        },
        {
            "chapter": 23,
            "verse": 54,
            "text": "فذرهم في غمرتهم حتى حين"
        },
        {
            "chapter": 23,
            "verse": 55,
            "text": "ايحسبون انما نمدهم به من مال وبنين"
        },
        {
            "chapter": 23,
            "verse": 56,
            "text": "نسارع لهم في الخيرات بل لا يشعرون"
        },
        {
            "chapter": 23,
            "verse": 57,
            "text": "ان الذين هم من خشية ربهم مشفقون"
        },
        {
            "chapter": 23,
            "verse": 58,
            "text": "والذين هم بايات ربهم يومنون"
        },
        {
            "chapter": 23,
            "verse": 59,
            "text": "والذين هم بربهم لا يشركون"
        }
    ]
}