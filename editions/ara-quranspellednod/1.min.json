{"chapter":[{"chapter":1,"verse":1,"text":"بسم الله الرحمن الرحيم"},{"chapter":1,"verse":2,"text":"الحمد لله رب العالمين"},{"chapter":1,"verse":3,"text":"الرحمن الرحيم"},{"chapter":1,"verse":4,"text":"مالك يوم الدين"},{"chapter":1,"verse":5,"text":"اياك نعبد واياك نستعين"},{"chapter":1,"verse":6,"text":"اهدنا الصراط المستقيم"},{"chapter":1,"verse":7,"text":"صراط الذين انعمت عليهم غير المغضوب عليهم ولا الضالين"}]}