{
    "rukus": [
        {
            "chapter": 51,
            "verse": 24,
            "text": "هل اتاك حديث ضيف ابراهيم المكرمين"
        },
        {
            "chapter": 51,
            "verse": 25,
            "text": "اذ دخلوا عليه فقالوا سلاما قال سلام قوم منكرون"
        },
        {
            "chapter": 51,
            "verse": 26,
            "text": "فراغ الى اهله فجاء بعجل سمين"
        },
        {
            "chapter": 51,
            "verse": 27,
            "text": "فقربه اليهم قال الا تاكلون"
        },
        {
            "chapter": 51,
            "verse": 28,
            "text": "فاوجس منهم خيفة قالوا لا تخف وبشروه بغلام عليم"
        },
        {
            "chapter": 51,
            "verse": 29,
            "text": "فاقبلت امراته في صرة فصكت وجهها وقالت عجوز عقيم"
        },
        {
            "chapter": 51,
            "verse": 30,
            "text": "قالوا كذلك قال ربك انه هو الحكيم العليم"
        },
        {
            "chapter": 51,
            "verse": 31,
            "text": "قال فما خطبكم ايها المرسلون"
        },
        {
            "chapter": 51,
            "verse": 32,
            "text": "قالوا انا ارسلنا الى قوم مجرمين"
        },
        {
            "chapter": 51,
            "verse": 33,
            "text": "لنرسل عليهم حجارة من طين"
        },
        {
            "chapter": 51,
            "verse": 34,
            "text": "مسومة عند ربك للمسرفين"
        },
        {
            "chapter": 51,
            "verse": 35,
            "text": "فاخرجنا من كان فيها من المومنين"
        },
        {
            "chapter": 51,
            "verse": 36,
            "text": "فما وجدنا فيها غير بيت من المسلمين"
        },
        {
            "chapter": 51,
            "verse": 37,
            "text": "وتركنا فيها اية للذين يخافون العذاب الاليم"
        },
        {
            "chapter": 51,
            "verse": 38,
            "text": "وفي موسى اذ ارسلناه الى فرعون بسلطان مبين"
        },
        {
            "chapter": 51,
            "verse": 39,
            "text": "فتولى بركنه وقال ساحر او مجنون"
        },
        {
            "chapter": 51,
            "verse": 40,
            "text": "فاخذناه وجنوده فنبذناهم في اليم وهو مليم"
        },
        {
            "chapter": 51,
            "verse": 41,
            "text": "وفي عاد اذ ارسلنا عليهم الريح العقيم"
        },
        {
            "chapter": 51,
            "verse": 42,
            "text": "ما تذر من شيء اتت عليه الا جعلته كالرميم"
        },
        {
            "chapter": 51,
            "verse": 43,
            "text": "وفي ثمود اذ قيل لهم تمتعوا حتى حين"
        },
        {
            "chapter": 51,
            "verse": 44,
            "text": "فعتوا عن امر ربهم فاخذتهم الصاعقة وهم ينظرون"
        },
        {
            "chapter": 51,
            "verse": 45,
            "text": "فما استطاعوا من قيام وما كانوا منتصرين"
        },
        {
            "chapter": 51,
            "verse": 46,
            "text": "وقوم نوح من قبل انهم كانوا قوما فاسقين"
        }
    ]
}