{
    "rukus": [
        {
            "chapter": 91,
            "verse": 1,
            "text": "والشمس وضحاها"
        },
        {
            "chapter": 91,
            "verse": 2,
            "text": "والقمر اذا تلاها"
        },
        {
            "chapter": 91,
            "verse": 3,
            "text": "والنهار اذا جلاها"
        },
        {
            "chapter": 91,
            "verse": 4,
            "text": "والليل اذا يغشاها"
        },
        {
            "chapter": 91,
            "verse": 5,
            "text": "والسماء وما بناها"
        },
        {
            "chapter": 91,
            "verse": 6,
            "text": "والارض وما طحاها"
        },
        {
            "chapter": 91,
            "verse": 7,
            "text": "ونفس وما سواها"
        },
        {
            "chapter": 91,
            "verse": 8,
            "text": "فالهمها فجورها وتقواها"
        },
        {
            "chapter": 91,
            "verse": 9,
            "text": "قد افلح من زكاها"
        },
        {
            "chapter": 91,
            "verse": 10,
            "text": "وقد خاب من دساها"
        },
        {
            "chapter": 91,
            "verse": 11,
            "text": "كذبت ثمود بطغواها"
        },
        {
            "chapter": 91,
            "verse": 12,
            "text": "اذ انبعث اشقاها"
        },
        {
            "chapter": 91,
            "verse": 13,
            "text": "فقال لهم رسول الله ناقة الله وسقياها"
        },
        {
            "chapter": 91,
            "verse": 14,
            "text": "فكذبوه فعقروها فدمدم عليهم ربهم بذنبهم فسواها"
        },
        {
            "chapter": 91,
            "verse": 15,
            "text": "ولا يخاف عقباها"
        }
    ]
}