{"rukus":[{"chapter":74,"verse":1,"text":"يا ايها المدثر"},{"chapter":74,"verse":2,"text":"قم فانذر"},{"chapter":74,"verse":3,"text":"وربك فكبر"},{"chapter":74,"verse":4,"text":"وثيابك فطهر"},{"chapter":74,"verse":5,"text":"والرجز فاهجر"},{"chapter":74,"verse":6,"text":"ولا تمنن تستكثر"},{"chapter":74,"verse":7,"text":"ولربك فاصبر"},{"chapter":74,"verse":8,"text":"فاذا نقر في الناقور"},{"chapter":74,"verse":9,"text":"فذلك يوميذ يوم عسير"},{"chapter":74,"verse":10,"text":"على الكافرين غير يسير"},{"chapter":74,"verse":11,"text":"ذرني ومن خلقت وحيدا"},{"chapter":74,"verse":12,"text":"وجعلت له مالا ممدودا"},{"chapter":74,"verse":13,"text":"وبنين شهودا"},{"chapter":74,"verse":14,"text":"ومهدت له تمهيدا"},{"chapter":74,"verse":15,"text":"ثم يطمع ان ازيد"},{"chapter":74,"verse":16,"text":"كلا انه كان لاياتنا عنيدا"},{"chapter":74,"verse":17,"text":"سارهقه صعودا"},{"chapter":74,"verse":18,"text":"انه فكر وقدر"},{"chapter":74,"verse":19,"text":"فقتل كيف قدر"},{"chapter":74,"verse":20,"text":"ثم قتل كيف قدر"},{"chapter":74,"verse":21,"text":"ثم نظر"},{"chapter":74,"verse":22,"text":"ثم عبس وبسر"},{"chapter":74,"verse":23,"text":"ثم ادبر واستكبر"},{"chapter":74,"verse":24,"text":"فقال ان هذا الا سحر يوثر"},{"chapter":74,"verse":25,"text":"ان هذا الا قول البشر"},{"chapter":74,"verse":26,"text":"ساصليه سقر"},{"chapter":74,"verse":27,"text":"وما ادراك ما سقر"},{"chapter":74,"verse":28,"text":"لا تبقي ولا تذر"},{"chapter":74,"verse":29,"text":"لواحة للبشر"},{"chapter":74,"verse":30,"text":"عليها تسعة عشر"},{"chapter":74,"verse":31,"text":"وما جعلنا اصحاب النار الا ملايكة وما جعلنا عدتهم الا فتنة للذين كفروا ليستيقن الذين اوتوا الكتاب ويزداد الذين امنوا ايمانا ولا يرتاب الذين اوتوا الكتاب والمومنون وليقول الذين في قلوبهم مرض والكافرون ماذا اراد الله بهذا مثلا كذلك يضل الله من يشاء ويهدي من يشاء وما يعلم جنود ربك الا هو وما هي الا ذكرى للبشر"}]}