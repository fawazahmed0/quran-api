{
    "rukus": [
        {
            "chapter": 15,
            "verse": 45,
            "text": "ان المتقين في جنات وعيون"
        },
        {
            "chapter": 15,
            "verse": 46,
            "text": "ادخلوها بسلام امنين"
        },
        {
            "chapter": 15,
            "verse": 47,
            "text": "ونزعنا ما في صدورهم من غل اخوانا على سرر متقابلين"
        },
        {
            "chapter": 15,
            "verse": 48,
            "text": "لا يمسهم فيها نصب وما هم منها بمخرجين"
        },
        {
            "chapter": 15,
            "verse": 49,
            "text": "نبي عبادي اني انا الغفور الرحيم"
        },
        {
            "chapter": 15,
            "verse": 50,
            "text": "وان عذابي هو العذاب الاليم"
        },
        {
            "chapter": 15,
            "verse": 51,
            "text": "ونبيهم عن ضيف ابراهيم"
        },
        {
            "chapter": 15,
            "verse": 52,
            "text": "اذ دخلوا عليه فقالوا سلاما قال انا منكم وجلون"
        },
        {
            "chapter": 15,
            "verse": 53,
            "text": "قالوا لا توجل انا نبشرك بغلام عليم"
        },
        {
            "chapter": 15,
            "verse": 54,
            "text": "قال ابشرتموني على ان مسني الكبر فبم تبشرون"
        },
        {
            "chapter": 15,
            "verse": 55,
            "text": "قالوا بشرناك بالحق فلا تكن من القانطين"
        },
        {
            "chapter": 15,
            "verse": 56,
            "text": "قال ومن يقنط من رحمة ربه الا الضالون"
        },
        {
            "chapter": 15,
            "verse": 57,
            "text": "قال فما خطبكم ايها المرسلون"
        },
        {
            "chapter": 15,
            "verse": 58,
            "text": "قالوا انا ارسلنا الى قوم مجرمين"
        },
        {
            "chapter": 15,
            "verse": 59,
            "text": "الا ال لوط انا لمنجوهم اجمعين"
        },
        {
            "chapter": 15,
            "verse": 60,
            "text": "الا امراته قدرنا انها لمن الغابرين"
        }
    ]
}