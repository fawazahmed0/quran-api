{
    "rukus": [
        {
            "chapter": 26,
            "verse": 34,
            "text": "قال للملا حوله ان هذا لساحر عليم"
        },
        {
            "chapter": 26,
            "verse": 35,
            "text": "يريد ان يخرجكم من ارضكم بسحره فماذا تامرون"
        },
        {
            "chapter": 26,
            "verse": 36,
            "text": "قالوا ارجه واخاه وابعث في المداين حاشرين"
        },
        {
            "chapter": 26,
            "verse": 37,
            "text": "ياتوك بكل سحار عليم"
        },
        {
            "chapter": 26,
            "verse": 38,
            "text": "فجمع السحرة لميقات يوم معلوم"
        },
        {
            "chapter": 26,
            "verse": 39,
            "text": "وقيل للناس هل انتم مجتمعون"
        },
        {
            "chapter": 26,
            "verse": 40,
            "text": "لعلنا نتبع السحرة ان كانوا هم الغالبين"
        },
        {
            "chapter": 26,
            "verse": 41,
            "text": "فلما جاء السحرة قالوا لفرعون اين لنا لاجرا ان كنا نحن الغالبين"
        },
        {
            "chapter": 26,
            "verse": 42,
            "text": "قال نعم وانكم اذا لمن المقربين"
        },
        {
            "chapter": 26,
            "verse": 43,
            "text": "قال لهم موسى القوا ما انتم ملقون"
        },
        {
            "chapter": 26,
            "verse": 44,
            "text": "فالقوا حبالهم وعصيهم وقالوا بعزة فرعون انا لنحن الغالبون"
        },
        {
            "chapter": 26,
            "verse": 45,
            "text": "فالقى موسى عصاه فاذا هي تلقف ما يافكون"
        },
        {
            "chapter": 26,
            "verse": 46,
            "text": "فالقي السحرة ساجدين"
        },
        {
            "chapter": 26,
            "verse": 47,
            "text": "قالوا امنا برب العالمين"
        },
        {
            "chapter": 26,
            "verse": 48,
            "text": "رب موسى وهارون"
        },
        {
            "chapter": 26,
            "verse": 49,
            "text": "قال امنتم له قبل ان اذن لكم انه لكبيركم الذي علمكم السحر فلسوف تعلمون لاقطعن ايديكم وارجلكم من خلاف ولاصلبنكم اجمعين"
        },
        {
            "chapter": 26,
            "verse": 50,
            "text": "قالوا لا ضير انا الى ربنا منقلبون"
        },
        {
            "chapter": 26,
            "verse": 51,
            "text": "انا نطمع ان يغفر لنا ربنا خطايانا ان كنا اول المومنين"
        },
        {
            "chapter": 26,
            "verse": 52,
            "text": "واوحينا الى موسى ان اسر بعبادي انكم متبعون"
        }
    ]
}