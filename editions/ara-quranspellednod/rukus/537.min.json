{"rukus":[{"chapter":95,"verse":1,"text":"والتين والزيتون"},{"chapter":95,"verse":2,"text":"وطور سينين"},{"chapter":95,"verse":3,"text":"وهذا البلد الامين"},{"chapter":95,"verse":4,"text":"لقد خلقنا الانسان في احسن تقويم"},{"chapter":95,"verse":5,"text":"ثم رددناه اسفل سافلين"},{"chapter":95,"verse":6,"text":"الا الذين امنوا وعملوا الصالحات فلهم اجر غير ممنون"},{"chapter":95,"verse":7,"text":"فما يكذبك بعد بالدين"},{"chapter":95,"verse":8,"text":"اليس الله باحكم الحاكمين"}]}