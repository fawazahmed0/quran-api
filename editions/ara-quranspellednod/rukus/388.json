{
    "rukus": [
        {
            "chapter": 37,
            "verse": 75,
            "text": "ولقد نادانا نوح فلنعم المجيبون"
        },
        {
            "chapter": 37,
            "verse": 76,
            "text": "ونجيناه واهله من الكرب العظيم"
        },
        {
            "chapter": 37,
            "verse": 77,
            "text": "وجعلنا ذريته هم الباقين"
        },
        {
            "chapter": 37,
            "verse": 78,
            "text": "وتركنا عليه في الاخرين"
        },
        {
            "chapter": 37,
            "verse": 79,
            "text": "سلام على نوح في العالمين"
        },
        {
            "chapter": 37,
            "verse": 80,
            "text": "انا كذلك نجزي المحسنين"
        },
        {
            "chapter": 37,
            "verse": 81,
            "text": "انه من عبادنا المومنين"
        },
        {
            "chapter": 37,
            "verse": 82,
            "text": "ثم اغرقنا الاخرين"
        },
        {
            "chapter": 37,
            "verse": 83,
            "text": "وان من شيعته لابراهيم"
        },
        {
            "chapter": 37,
            "verse": 84,
            "text": "اذ جاء ربه بقلب سليم"
        },
        {
            "chapter": 37,
            "verse": 85,
            "text": "اذ قال لابيه وقومه ماذا تعبدون"
        },
        {
            "chapter": 37,
            "verse": 86,
            "text": "ايفكا الهة دون الله تريدون"
        },
        {
            "chapter": 37,
            "verse": 87,
            "text": "فما ظنكم برب العالمين"
        },
        {
            "chapter": 37,
            "verse": 88,
            "text": "فنظر نظرة في النجوم"
        },
        {
            "chapter": 37,
            "verse": 89,
            "text": "فقال اني سقيم"
        },
        {
            "chapter": 37,
            "verse": 90,
            "text": "فتولوا عنه مدبرين"
        },
        {
            "chapter": 37,
            "verse": 91,
            "text": "فراغ الى الهتهم فقال الا تاكلون"
        },
        {
            "chapter": 37,
            "verse": 92,
            "text": "ما لكم لا تنطقون"
        },
        {
            "chapter": 37,
            "verse": 93,
            "text": "فراغ عليهم ضربا باليمين"
        },
        {
            "chapter": 37,
            "verse": 94,
            "text": "فاقبلوا اليه يزفون"
        },
        {
            "chapter": 37,
            "verse": 95,
            "text": "قال اتعبدون ما تنحتون"
        },
        {
            "chapter": 37,
            "verse": 96,
            "text": "والله خلقكم وما تعملون"
        },
        {
            "chapter": 37,
            "verse": 97,
            "text": "قالوا ابنوا له بنيانا فالقوه في الجحيم"
        },
        {
            "chapter": 37,
            "verse": 98,
            "text": "فارادوا به كيدا فجعلناهم الاسفلين"
        },
        {
            "chapter": 37,
            "verse": 99,
            "text": "وقال اني ذاهب الى ربي سيهدين"
        },
        {
            "chapter": 37,
            "verse": 100,
            "text": "رب هب لي من الصالحين"
        },
        {
            "chapter": 37,
            "verse": 101,
            "text": "فبشرناه بغلام حليم"
        },
        {
            "chapter": 37,
            "verse": 102,
            "text": "فلما بلغ معه السعي قال يا بني اني ارى في المنام اني اذبحك فانظر ماذا ترى قال يا ابت افعل ما تومر ستجدني ان شاء الله من الصابرين"
        },
        {
            "chapter": 37,
            "verse": 103,
            "text": "فلما اسلما وتله للجبين"
        },
        {
            "chapter": 37,
            "verse": 104,
            "text": "وناديناه ان يا ابراهيم"
        },
        {
            "chapter": 37,
            "verse": 105,
            "text": "قد صدقت الرويا انا كذلك نجزي المحسنين"
        },
        {
            "chapter": 37,
            "verse": 106,
            "text": "ان هذا لهو البلاء المبين"
        },
        {
            "chapter": 37,
            "verse": 107,
            "text": "وفديناه بذبح عظيم"
        },
        {
            "chapter": 37,
            "verse": 108,
            "text": "وتركنا عليه في الاخرين"
        },
        {
            "chapter": 37,
            "verse": 109,
            "text": "سلام على ابراهيم"
        },
        {
            "chapter": 37,
            "verse": 110,
            "text": "كذلك نجزي المحسنين"
        },
        {
            "chapter": 37,
            "verse": 111,
            "text": "انه من عبادنا المومنين"
        },
        {
            "chapter": 37,
            "verse": 112,
            "text": "وبشرناه باسحاق نبيا من الصالحين"
        },
        {
            "chapter": 37,
            "verse": 113,
            "text": "وباركنا عليه وعلى اسحاق ومن ذريتهما محسن وظالم لنفسه مبين"
        }
    ]
}