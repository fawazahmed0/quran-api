{
    "rukus": [
        {
            "chapter": 15,
            "verse": 80,
            "text": "ولقد كذب اصحاب الحجر المرسلين"
        },
        {
            "chapter": 15,
            "verse": 81,
            "text": "واتيناهم اياتنا فكانوا عنها معرضين"
        },
        {
            "chapter": 15,
            "verse": 82,
            "text": "وكانوا ينحتون من الجبال بيوتا امنين"
        },
        {
            "chapter": 15,
            "verse": 83,
            "text": "فاخذتهم الصيحة مصبحين"
        },
        {
            "chapter": 15,
            "verse": 84,
            "text": "فما اغنى عنهم ما كانوا يكسبون"
        },
        {
            "chapter": 15,
            "verse": 85,
            "text": "وما خلقنا السماوات والارض وما بينهما الا بالحق وان الساعة لاتية فاصفح الصفح الجميل"
        },
        {
            "chapter": 15,
            "verse": 86,
            "text": "ان ربك هو الخلاق العليم"
        },
        {
            "chapter": 15,
            "verse": 87,
            "text": "ولقد اتيناك سبعا من المثاني والقران العظيم"
        },
        {
            "chapter": 15,
            "verse": 88,
            "text": "لا تمدن عينيك الى ما متعنا به ازواجا منهم ولا تحزن عليهم واخفض جناحك للمومنين"
        },
        {
            "chapter": 15,
            "verse": 89,
            "text": "وقل اني انا النذير المبين"
        },
        {
            "chapter": 15,
            "verse": 90,
            "text": "كما انزلنا على المقتسمين"
        },
        {
            "chapter": 15,
            "verse": 91,
            "text": "الذين جعلوا القران عضين"
        },
        {
            "chapter": 15,
            "verse": 92,
            "text": "فوربك لنسالنهم اجمعين"
        },
        {
            "chapter": 15,
            "verse": 93,
            "text": "عما كانوا يعملون"
        },
        {
            "chapter": 15,
            "verse": 94,
            "text": "فاصدع بما تومر واعرض عن المشركين"
        },
        {
            "chapter": 15,
            "verse": 95,
            "text": "انا كفيناك المستهزيين"
        },
        {
            "chapter": 15,
            "verse": 96,
            "text": "الذين يجعلون مع الله الها اخر فسوف يعلمون"
        },
        {
            "chapter": 15,
            "verse": 97,
            "text": "ولقد نعلم انك يضيق صدرك بما يقولون"
        },
        {
            "chapter": 15,
            "verse": 98,
            "text": "فسبح بحمد ربك وكن من الساجدين"
        },
        {
            "chapter": 15,
            "verse": 99,
            "text": "واعبد ربك حتى ياتيك اليقين"
        }
    ]
}