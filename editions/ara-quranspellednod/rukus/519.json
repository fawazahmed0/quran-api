{
    "rukus": [
        {
            "chapter": 78,
            "verse": 31,
            "text": "ان للمتقين مفازا"
        },
        {
            "chapter": 78,
            "verse": 32,
            "text": "حدايق واعنابا"
        },
        {
            "chapter": 78,
            "verse": 33,
            "text": "وكواعب اترابا"
        },
        {
            "chapter": 78,
            "verse": 34,
            "text": "وكاسا دهاقا"
        },
        {
            "chapter": 78,
            "verse": 35,
            "text": "لا يسمعون فيها لغوا ولا كذابا"
        },
        {
            "chapter": 78,
            "verse": 36,
            "text": "جزاء من ربك عطاء حسابا"
        },
        {
            "chapter": 78,
            "verse": 37,
            "text": "رب السماوات والارض وما بينهما الرحمن لا يملكون منه خطابا"
        },
        {
            "chapter": 78,
            "verse": 38,
            "text": "يوم يقوم الروح والملايكة صفا لا يتكلمون الا من اذن له الرحمن وقال صوابا"
        },
        {
            "chapter": 78,
            "verse": 39,
            "text": "ذلك اليوم الحق فمن شاء اتخذ الى ربه مابا"
        },
        {
            "chapter": 78,
            "verse": 40,
            "text": "انا انذرناكم عذابا قريبا يوم ينظر المرء ما قدمت يداه ويقول الكافر يا ليتني كنت ترابا"
        }
    ]
}