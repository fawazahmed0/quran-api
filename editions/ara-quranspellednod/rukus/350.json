{
    "rukus": [
        {
            "chapter": 30,
            "verse": 11,
            "text": "الله يبدا الخلق ثم يعيده ثم اليه ترجعون"
        },
        {
            "chapter": 30,
            "verse": 12,
            "text": "ويوم تقوم الساعة يبلس المجرمون"
        },
        {
            "chapter": 30,
            "verse": 13,
            "text": "ولم يكن لهم من شركايهم شفعاء وكانوا بشركايهم كافرين"
        },
        {
            "chapter": 30,
            "verse": 14,
            "text": "ويوم تقوم الساعة يوميذ يتفرقون"
        },
        {
            "chapter": 30,
            "verse": 15,
            "text": "فاما الذين امنوا وعملوا الصالحات فهم في روضة يحبرون"
        },
        {
            "chapter": 30,
            "verse": 16,
            "text": "واما الذين كفروا وكذبوا باياتنا ولقاء الاخرة فاوليك في العذاب محضرون"
        },
        {
            "chapter": 30,
            "verse": 17,
            "text": "فسبحان الله حين تمسون وحين تصبحون"
        },
        {
            "chapter": 30,
            "verse": 18,
            "text": "وله الحمد في السماوات والارض وعشيا وحين تظهرون"
        },
        {
            "chapter": 30,
            "verse": 19,
            "text": "يخرج الحي من الميت ويخرج الميت من الحي ويحيي الارض بعد موتها وكذلك تخرجون"
        }
    ]
}