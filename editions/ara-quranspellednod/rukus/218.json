{
    "rukus": [
        {
            "chapter": 15,
            "verse": 1,
            "text": "الر تلك ايات الكتاب وقران مبين"
        },
        {
            "chapter": 15,
            "verse": 2,
            "text": "ربما يود الذين كفروا لو كانوا مسلمين"
        },
        {
            "chapter": 15,
            "verse": 3,
            "text": "ذرهم ياكلوا ويتمتعوا ويلههم الامل فسوف يعلمون"
        },
        {
            "chapter": 15,
            "verse": 4,
            "text": "وما اهلكنا من قرية الا ولها كتاب معلوم"
        },
        {
            "chapter": 15,
            "verse": 5,
            "text": "ما تسبق من امة اجلها وما يستاخرون"
        },
        {
            "chapter": 15,
            "verse": 6,
            "text": "وقالوا يا ايها الذي نزل عليه الذكر انك لمجنون"
        },
        {
            "chapter": 15,
            "verse": 7,
            "text": "لو ما تاتينا بالملايكة ان كنت من الصادقين"
        },
        {
            "chapter": 15,
            "verse": 8,
            "text": "ما ننزل الملايكة الا بالحق وما كانوا اذا منظرين"
        },
        {
            "chapter": 15,
            "verse": 9,
            "text": "انا نحن نزلنا الذكر وانا له لحافظون"
        },
        {
            "chapter": 15,
            "verse": 10,
            "text": "ولقد ارسلنا من قبلك في شيع الاولين"
        },
        {
            "chapter": 15,
            "verse": 11,
            "text": "وما ياتيهم من رسول الا كانوا به يستهزيون"
        },
        {
            "chapter": 15,
            "verse": 12,
            "text": "كذلك نسلكه في قلوب المجرمين"
        },
        {
            "chapter": 15,
            "verse": 13,
            "text": "لا يومنون به وقد خلت سنة الاولين"
        },
        {
            "chapter": 15,
            "verse": 14,
            "text": "ولو فتحنا عليهم بابا من السماء فظلوا فيه يعرجون"
        },
        {
            "chapter": 15,
            "verse": 15,
            "text": "لقالوا انما سكرت ابصارنا بل نحن قوم مسحورون"
        }
    ]
}