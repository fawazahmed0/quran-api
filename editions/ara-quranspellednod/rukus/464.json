{
    "rukus": [
        {
            "chapter": 54,
            "verse": 23,
            "text": "كذبت ثمود بالنذر"
        },
        {
            "chapter": 54,
            "verse": 24,
            "text": "فقالوا ابشرا منا واحدا نتبعه انا اذا لفي ضلال وسعر"
        },
        {
            "chapter": 54,
            "verse": 25,
            "text": "االقي الذكر عليه من بيننا بل هو كذاب اشر"
        },
        {
            "chapter": 54,
            "verse": 26,
            "text": "سيعلمون غدا من الكذاب الاشر"
        },
        {
            "chapter": 54,
            "verse": 27,
            "text": "انا مرسلو الناقة فتنة لهم فارتقبهم واصطبر"
        },
        {
            "chapter": 54,
            "verse": 28,
            "text": "ونبيهم ان الماء قسمة بينهم كل شرب محتضر"
        },
        {
            "chapter": 54,
            "verse": 29,
            "text": "فنادوا صاحبهم فتعاطى فعقر"
        },
        {
            "chapter": 54,
            "verse": 30,
            "text": "فكيف كان عذابي ونذر"
        },
        {
            "chapter": 54,
            "verse": 31,
            "text": "انا ارسلنا عليهم صيحة واحدة فكانوا كهشيم المحتظر"
        },
        {
            "chapter": 54,
            "verse": 32,
            "text": "ولقد يسرنا القران للذكر فهل من مدكر"
        },
        {
            "chapter": 54,
            "verse": 33,
            "text": "كذبت قوم لوط بالنذر"
        },
        {
            "chapter": 54,
            "verse": 34,
            "text": "انا ارسلنا عليهم حاصبا الا ال لوط نجيناهم بسحر"
        },
        {
            "chapter": 54,
            "verse": 35,
            "text": "نعمة من عندنا كذلك نجزي من شكر"
        },
        {
            "chapter": 54,
            "verse": 36,
            "text": "ولقد انذرهم بطشتنا فتماروا بالنذر"
        },
        {
            "chapter": 54,
            "verse": 37,
            "text": "ولقد راودوه عن ضيفه فطمسنا اعينهم فذوقوا عذابي ونذر"
        },
        {
            "chapter": 54,
            "verse": 38,
            "text": "ولقد صبحهم بكرة عذاب مستقر"
        },
        {
            "chapter": 54,
            "verse": 39,
            "text": "فذوقوا عذابي ونذر"
        },
        {
            "chapter": 54,
            "verse": 40,
            "text": "ولقد يسرنا القران للذكر فهل من مدكر"
        }
    ]
}