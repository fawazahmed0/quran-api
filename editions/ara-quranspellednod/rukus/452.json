{
    "rukus": [
        {
            "chapter": 50,
            "verse": 1,
            "text": "ق والقران المجيد"
        },
        {
            "chapter": 50,
            "verse": 2,
            "text": "بل عجبوا ان جاءهم منذر منهم فقال الكافرون هذا شيء عجيب"
        },
        {
            "chapter": 50,
            "verse": 3,
            "text": "ااذا متنا وكنا ترابا ذلك رجع بعيد"
        },
        {
            "chapter": 50,
            "verse": 4,
            "text": "قد علمنا ما تنقص الارض منهم وعندنا كتاب حفيظ"
        },
        {
            "chapter": 50,
            "verse": 5,
            "text": "بل كذبوا بالحق لما جاءهم فهم في امر مريج"
        },
        {
            "chapter": 50,
            "verse": 6,
            "text": "افلم ينظروا الى السماء فوقهم كيف بنيناها وزيناها وما لها من فروج"
        },
        {
            "chapter": 50,
            "verse": 7,
            "text": "والارض مددناها والقينا فيها رواسي وانبتنا فيها من كل زوج بهيج"
        },
        {
            "chapter": 50,
            "verse": 8,
            "text": "تبصرة وذكرى لكل عبد منيب"
        },
        {
            "chapter": 50,
            "verse": 9,
            "text": "ونزلنا من السماء ماء مباركا فانبتنا به جنات وحب الحصيد"
        },
        {
            "chapter": 50,
            "verse": 10,
            "text": "والنخل باسقات لها طلع نضيد"
        },
        {
            "chapter": 50,
            "verse": 11,
            "text": "رزقا للعباد واحيينا به بلدة ميتا كذلك الخروج"
        },
        {
            "chapter": 50,
            "verse": 12,
            "text": "كذبت قبلهم قوم نوح واصحاب الرس وثمود"
        },
        {
            "chapter": 50,
            "verse": 13,
            "text": "وعاد وفرعون واخوان لوط"
        },
        {
            "chapter": 50,
            "verse": 14,
            "text": "واصحاب الايكة وقوم تبع كل كذب الرسل فحق وعيد"
        },
        {
            "chapter": 50,
            "verse": 15,
            "text": "افعيينا بالخلق الاول بل هم في لبس من خلق جديد"
        }
    ]
}