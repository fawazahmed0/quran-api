{
    "rukus": [
        {
            "chapter": 55,
            "verse": 26,
            "text": "كل من عليها فان"
        },
        {
            "chapter": 55,
            "verse": 27,
            "text": "ويبقى وجه ربك ذو الجلال والاكرام"
        },
        {
            "chapter": 55,
            "verse": 28,
            "text": "فباي الاء ربكما تكذبان"
        },
        {
            "chapter": 55,
            "verse": 29,
            "text": "يساله من في السماوات والارض كل يوم هو في شان"
        },
        {
            "chapter": 55,
            "verse": 30,
            "text": "فباي الاء ربكما تكذبان"
        },
        {
            "chapter": 55,
            "verse": 31,
            "text": "سنفرغ لكم ايه الثقلان"
        },
        {
            "chapter": 55,
            "verse": 32,
            "text": "فباي الاء ربكما تكذبان"
        },
        {
            "chapter": 55,
            "verse": 33,
            "text": "يا معشر الجن والانس ان استطعتم ان تنفذوا من اقطار السماوات والارض فانفذوا لا تنفذون الا بسلطان"
        },
        {
            "chapter": 55,
            "verse": 34,
            "text": "فباي الاء ربكما تكذبان"
        },
        {
            "chapter": 55,
            "verse": 35,
            "text": "يرسل عليكما شواظ من نار ونحاس فلا تنتصران"
        },
        {
            "chapter": 55,
            "verse": 36,
            "text": "فباي الاء ربكما تكذبان"
        },
        {
            "chapter": 55,
            "verse": 37,
            "text": "فاذا انشقت السماء فكانت وردة كالدهان"
        },
        {
            "chapter": 55,
            "verse": 38,
            "text": "فباي الاء ربكما تكذبان"
        },
        {
            "chapter": 55,
            "verse": 39,
            "text": "فيوميذ لا يسال عن ذنبه انس ولا جان"
        },
        {
            "chapter": 55,
            "verse": 40,
            "text": "فباي الاء ربكما تكذبان"
        },
        {
            "chapter": 55,
            "verse": 41,
            "text": "يعرف المجرمون بسيماهم فيوخذ بالنواصي والاقدام"
        },
        {
            "chapter": 55,
            "verse": 42,
            "text": "فباي الاء ربكما تكذبان"
        },
        {
            "chapter": 55,
            "verse": 43,
            "text": "هذه جهنم التي يكذب بها المجرمون"
        },
        {
            "chapter": 55,
            "verse": 44,
            "text": "يطوفون بينها وبين حميم ان"
        },
        {
            "chapter": 55,
            "verse": 45,
            "text": "فباي الاء ربكما تكذبان"
        }
    ]
